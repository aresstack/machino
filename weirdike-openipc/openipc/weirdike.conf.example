# weirdiked configuration.
#
# Install as /etc/weirdike/weirdike.conf with mode 0600. The daemon REFUSES to
# read a file that is group- or world-accessible, because this file holds a
# pre-shared key.
#
# Syntax is `key = value`, one per line, # starts a comment. An unknown key is
# an error, not a warning: a typo must not silently leave a setting at its
# default.

# --- required ---------------------------------------------------------------

# IPv4 literal or hostname. Letters, digits, dot and hyphen only.
gateway = vpn.example.com

# Pre-shared key. Keep this file at 0600 and out of backups.
psk = change-me

# --- identities (optional) ---------------------------------------------------

# Our IKE identity. Empty = derived from the source IP.
# local_id = camera1.example.com

# The identity we require from the gateway. Empty = accept what it presents.
# Setting this is the difference between "some peer with the PSK" and "that
# peer", so set it if the gateway has a stable name.
# remote_id = vpn.example.com

# AP10: the TYPE of each identity, exactly as the gateway expects it ("send
# as" / "expect as" in WeirdOS). fqdn (default) | rfc822 (e-mail address) |
# ipv4 (the value must then be a dotted quad) | keyid. Only meaningful when
# the identity itself is set.
# local_id_type = rfc822
# remote_id_type = fqdn

# --- what the tunnel carries -------------------------------------------------

# The network behind the gateway. Default: 0.0.0.0/0 (everything).
# remote_subnet = 10.0.0.0/8

# The network we present as ours (TSi). Usually just the camera.
# local_subnet = 192.168.1.10/32

# AP10: ask the gateway for the tunnel address instead (IKEv2 Configuration
# Payload, INTERNAL_IP4_ADDRESS/DNS/SUBNET) -- with PSK too. machinod sets
# this whenever local_subnet is empty; EAP-MSCHAPv2 always requests it.
# The assigned address becomes the ipsec0 address unless local_subnet is set.
# request_cp = yes

# AP10: Perfect Forward Secrecy on Child rekeys -- a fresh D-H exchange in
# every CREATE_CHILD_SA. The number is the D-H group (14 = modp2048, the
# only group this build negotiates). 0 = no PFS (the pre-AP10 behaviour).
# pfs_group = 14

# --- transport ---------------------------------------------------------------

# port = 500
# nat_t = yes        # UDP-4500 encapsulation; the only supported data path

# TUN interface name.
# interface = ipsec0

# The tunnel MTU. 1400 leaves room for the ESP and UDP headers on a 1500-byte
# path; lower it if the path is smaller.
# mtu = 1400

# --- lifetimes ----------------------------------------------------------------

# child_lifetime_s = 3300   # 0 = library default (55 min)
# ike_lifetime_s   = 0      # 0 = never rekey the IKE SA ourselves
# dpd_interval_s   = 30     # 0 = library default
