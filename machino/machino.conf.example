# Machino - example configuration
# Flat "section.key = value". Unknown keys are ignored with a warning.

# --- hardware: select ONE board profile -----------------------------------
# The profile carries platform, sensor, wiring (i2c bus/addr, mclk, reset/pwdn
# pins) and the default mode. t40nn-imx307-board-a is the hardware-verified
# reference board (see docs/architecture/board-profiles.md). It describes that
# board's wiring only; other T40NN/IMX307 cameras may differ.
board = t40nn-imx307-board-a

# Alternative: an external profile file (registered under its board_id)
#board_profile_file = /etc/machino/my-board.conf

# Explicit overrides (user config > board profile). Uncomment only what you
# know for your board. Pins: number or "none". Nothing here is guessed.
#platform          = ingenic-t40nn
#sensor.model      = imx307
#sensor.i2c_bus    = 1
#sensor.i2c_addr   = 0x1a
#sensor.mclk       = 1
#sensor.reset_gpio = 91
#sensor.pwdn_gpio  = 0
#sensor.mode       = 1920x1080@20      # must be a verified mode of the sensor

# --- video stream 0 (H.264) ------------------------------------------------
# width/height/fps default to the resolved sensor mode
#video.width       = 1920
#video.height      = 1080
#video.fps         = 20
video.gop         = 40
video.bitrate     = 3000      # kbps
video.profile     = 2         # 0 baseline, 1 main, 2 high
video.rc_mode     = cbr       # cbr | vbr | fixqp
video.buffers     = 2
#video.encoder_buffers = 2 # absent = SDK default; explicit 1..8 requires pipeline restart

# --- latency ---------------------------------------------------------------
# A profile is only a documented preset; explicit latency.* values win:
#   normal: video GOP/buffers, SDK encoder-buffer default, queue depth 4
#   low:    GOP = current FPS (one-second IDR cadence), FrameSource buffers 1,
#           encoder stream buffers 1, per-client AU queue depth 1
#   custom: video GOP/buffers plus explicit overrides below
latency.profile = normal            # normal | low | custom
#latency.gop = 20
#latency.framesource_buffers = 1
#latency.encoder_buffers = 1
#latency.queue_depth = 1

# --- rtsp -------------------------------------------------------------------
rtsp.port         = 554
rtsp.path         = /ch0
rtsp.send_buffer_bytes = 65536      # bounded kernel backlog per client
rtsp.send_stall_ms     = 750        # disconnect stalled client; no seconds-old backlog

# --- image / ISP -----------------------------------------------------------
# Every key is optional. Absent means "preserve the sensor tuning-bin / ISP
# default"; Machino does not impose magic colour or exposure values.
#image.brightness = 128
#image.contrast = 128
#image.saturation = 128
#image.sharpness = 128
#image.hue = 128
#image.anti_flicker = 50hz          # off | 50hz | 60hz; explicit regional choice
#image.ae_compensation = 128         # 0 disables compensation; AE remains automatic
#image.highlight_depress = 0
#image.backlight_comp = 0
#image.white_balance_mode = 0        # 0 auto; other SDK modes are capability-backed
#image.temporal_nr = 1
#image.spatial_nr = 1
#image.dpc = 1
#image.defog = 0

# --- media lifecycle: "no consumer, no pipeline" -----------------------------
# The daemon and the RTSP listener are always up; sensor/ISP/encoder come up
# on the first consumer (RTSP PLAY) and are torn down completely
# lifecycle.idle_grace_ms after the last consumer left (GRACE_IDLE bridges
# reconnects). always_on = 1 holds a permanent manual demand; SIGUSR2 / SIGUSR1
# take / drop that manual demand at runtime.
pipeline.always_on        = 0
lifecycle.idle_grace_ms   = 5000
pipeline.poll_timeout_ms  = 500

# --- performance / power (continuous streaming) ------------------------------
# Profiles are presets over sensor.fps / video.fps / video.bitrate:
#   performance = board/sensor default point, balanced = board preset or the
#   next lower verified point, battery = lowest verified point, custom = the
#   explicit values below. Values outside the known range or unverified
#   operating points are rejected (sensor.allow_unverified_mode = 1 opts in
#   for qualification runs). Send SIGHUP to re-apply this file at runtime.
performance.profile       = performance
#sensor.fps               = 15        # requested SENSOR rate (live, read back from the ISP)
#video.fps                = 15        # stream rate (pipeline restart, demand preserved)
# power levels: auto = adapter/kernel default (nothing is forced); low/high only
# where the platform offers a safe interface (T40: ISP/encoder clocks are
# read-only -> unsupported; cpufreq not exposed by the OpenIPC kernel)
power.isp_performance     = auto
power.encoder_performance = auto
power.cpu_performance     = auto

# --- HTTP control / telemetry API (/api/v1) ---------------------------------
# Reads and SSE connections are never media demand. PATCH /api/v1/config
# persists the managed keys of THIS file atomically and bumps config.revision.
api.enabled               = 1
api.bind                  = 0.0.0.0
api.port                  = 8080

# --- telemetry -------------------------------------------------------------
# 0 = off; N = one compact line every N seconds (state, requested/effective fps,
# measured fps/bitrate, drops, cpu, rss, threads, known clocks)
telemetry.log_interval_s  = 0

# --- logging ----------------------------------------------------------------
log.level         = 2         # 0 err, 1 warn, 2 info, 3 debug (3 shows value provenance)
log.syslog        = 0
