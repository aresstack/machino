#!/bin/sh
# Boot-time media owner selection.
#
# OpenIPC's rcS runs every /etc/init.d/S??* unconditionally - it does not test
# the executable bit, so "chmod -x" is not a disable mechanism, it only makes
# the invocation fail. install.sh therefore moves S95majestic aside to
# /etc/init.d/majestic and puts this script in its slot: exactly one script
# decides who owns the media hardware, and it starts exactly one of them.
case "$1" in
	start)
		/usr/sbin/streamerctl boot
		;;
	stop)
		# rcK order: release the media hardware before the rest of the system
		# goes down. Leave the WebUI host alone, it costs nothing and shutting
		# it down here would only hide errors from the operator.
		[ -x /etc/init.d/machino ]  && /etc/init.d/machino stop
		[ -x /etc/init.d/majestic ] && /etc/init.d/majestic stop
		;;
	restart)
		$0 stop
		sleep 2
		$0 start
		;;
	status)
		/usr/sbin/streamerctl status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
