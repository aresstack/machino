#!/bin/sh
web_up() {
    [ -f "/c/tmp/machino-src/machino/tests/tmp-streamerctl/run/majestic" ] && return 0
    if [ -f "/c/tmp/machino-src/machino/tests/tmp-streamerctl/run/httpd.pid" ]; then
        p=$(cat "/c/tmp/machino-src/machino/tests/tmp-streamerctl/run/httpd.pid")
        kill -0 "$p" 2>/dev/null && return 0
    fi
    return 1
}
case "$*" in
    *api/v1/state*)
        [ -f "/c/tmp/machino-src/machino/tests/tmp-streamerctl/run/machino" ] || exit 1
        [ -f "/c/tmp/machino-src/machino/tests/tmp-streamerctl/run/api.fail" ] && exit 1
        echo '{"lifecycle":"cold_idle"}'; exit 0 ;;
    *index.html*)
        [ -f "/c/tmp/machino-src/machino/tests/tmp-streamerctl/run/web.fail" ] && exit 1
        web_up || exit 1
        echo '<html/>'; exit 0 ;;
esac
exit 1
