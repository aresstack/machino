#!/bin/sh
# WLAN beim Boot: Module, Portstrom, Supplicant, DHCP.
#
# WARUM DAS EIN INIT-SKRIPT IST UND NICHT MACHINO
#
# Jeder Schritt hier startet einen Prozess oder laedt ein Modul. machino darf
# beides nicht, solange die IMP-Pipeline laeuft: fork+exec ist auf dieser
# Kamera der dokumentierte Ausloeser eines Out-of-Memory-Vorfalls. Deshalb
# passiert alles Prozess-Startende VOR machinod -- S42 liegt hinter S41yt8512
# (Ethernet) und weit vor S95streamer.
#
# machino uebernimmt danach die Steuerung ueber Sockets: wpa_supplicant ueber
# sein Control-Interface, hostapd ueber seins. Kein Fork zur Laufzeit.
#
# REIHENFOLGE
#
# Die ist nicht beliebig, sie ist auf Hardware erarbeitet (siehe
# machino/docs/aic8800-bringup.md):
#
#   cfg80211            ist in diesem Kernel NICHT eingebaut, sondern Modul
#   aic_load_fw         liefert Symbole fuer aic8800 (depends=aic_load_fw)
#   aic8800
#   GPIO 50 = PB18      Portstrom ZULETZT: das Geraet taucht auf, wenn der
#                       Treiber schon registriert ist, dann passieren
#                       Enumeration und Binding in einem Zug
#
# Die Module muessen mit CONFIG_PREALLOC_RX_SKB=n gebaut sein. Mit dem
# Upstream-Default fordert der Treiber beim Init 847 order-3-Bloecke an; diese
# Kamera hat rund 20 davon frei, der OOM-Killer trifft den Mediendaemon, und
# der haelt /dev/watchdog. Ergebnis: Reboot.

MODDIR=/etc/machino/modules
WPACONF=/etc/machino/wpa-supplicant.conf
CTRL=/var/run/wpa_supplicant
DHCPSCRIPT=/etc/machino/udhcpc-wlan.script
IFACE=wlan0
GPIO=50

load_modules() {
	modprobe cfg80211 2>/dev/null
	for m in aic_load_fw aic8800; do
		lsmod | grep -q "^$m " && continue
		[ -f "$MODDIR/$m.ko" ] || { echo "wifi: $MODDIR/$m.ko fehlt"; return 1; }
		insmod "$MODDIR/$m.ko" || { echo "wifi: $m liess sich nicht laden"; return 1; }
	done
	return 0
}

port_power_on() {
	[ -d /sys/class/gpio/gpio$GPIO ] || echo $GPIO > /sys/class/gpio/export 2>/dev/null
	[ -d /sys/class/gpio/gpio$GPIO ] || { echo "wifi: GPIO $GPIO nicht exportierbar"; return 1; }
	echo out > /sys/class/gpio/gpio$GPIO/direction
	echo 1   > /sys/class/gpio/gpio$GPIO/value
}

wait_for_iface() {
	# Enumeration, Firmware-Upload und Interface-Anlage brauchen auf dieser
	# Box rund drei Sekunden. Feste Wartezeit waere entweder zu kurz oder
	# verschenkt Bootzeit, also wird gepollt.
	n=0
	while [ ! -d /sys/class/net/$IFACE ]; do
		n=$((n + 1))
		[ $n -ge 60 ] && return 1      # 15 s
		usleep 250000 2>/dev/null || sleep 1
	done
	return 0
}

start() {
	load_modules || return 1
	port_power_on || return 1
	if ! wait_for_iface; then
		echo "wifi: $IFACE erschien nicht - haengt das Modul am Port?"
		return 1
	fi
	ip link set $IFACE up
	echo "wifi: $IFACE bereit"

	# Der Supplicant laeuft IMMER, auch ohne konfiguriertes Netz. machino
	# braucht sein Control-Interface, um scannen und verbinden zu koennen --
	# ohne laufenden Supplicant meldet die API "station mode is not usable"
	# und der Benutzer kaeme nie zu einer Konfiguration.
	[ -x /usr/sbin/wpa_supplicant ] || { echo "wifi: kein wpa_supplicant im Image"; return 0; }
	mkdir -p "$CTRL"
	if [ ! -f "$WPACONF" ]; then
		umask 077
		mkdir -p /etc/machino
		printf 'ctrl_interface=%s\nupdate_config=1\n' "$CTRL" > "$WPACONF"
		chmod 600 "$WPACONF"
	fi
	echo -n "wifi: starte wpa_supplicant: "
	wpa_supplicant -B -i $IFACE -c "$WPACONF" -D nl80211 >/dev/null 2>&1 \
		&& echo OK || { echo FEHLGESCHLAGEN; return 1; }

	# DHCP als Daemon, nicht einmalig. Nach einem Rollback assoziiert der
	# Supplicant von selbst neu -- ohne laufenden Client bliebe das Interface
	# dann ohne Adresse, also assoziiert und unbrauchbar. Genau diese Luecke
	# war nach dem H9-Test offen.
	[ -x /usr/sbin/udhcpc ] || [ -x /sbin/udhcpc ] || return 0
	echo -n "wifi: starte udhcpc: "
	if [ -x "$DHCPSCRIPT" ]; then
		udhcpc -i $IFACE -b -t 0 -S -s "$DHCPSCRIPT" >/dev/null 2>&1 && echo OK || echo FEHLGESCHLAGEN
	else
		udhcpc -i $IFACE -b -t 0 -S >/dev/null 2>&1 && echo OK || echo FEHLGESCHLAGEN
	fi
}

stop() {
	[ -f /var/run/udhcpc.$IFACE.pid ] && kill "$(cat /var/run/udhcpc.$IFACE.pid)" 2>/dev/null
	rm -f /var/run/udhcpc.$IFACE.pid
	killall wpa_supplicant 2>/dev/null
	ip link set $IFACE down 2>/dev/null
	# Portstrom bleibt AN. Ihn abzuschalten wuerde das Geraet abmelden,
	# waehrend machino unter Umstaenden noch laeuft und es abfragt.
}

case "$1" in
	start) start ;;
	stop)  stop ;;
	restart) stop; sleep 2; start ;;
	status)
		echo "iface:   $([ -d /sys/class/net/$IFACE ] && echo vorhanden || echo fehlt)"
		echo "modules: $(lsmod | grep -c '^aic') aic-Module geladen"
		echo "supplicant: $([ -e $CTRL/$IFACE ] && echo laeuft || echo aus)"
		;;
	*) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
