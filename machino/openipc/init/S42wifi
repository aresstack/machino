#!/bin/sh
# WLAN beim Boot: Module, Portstrom, Supplicant, DHCP.
#
# WARUM DAS EIN INIT-SKRIPT IST UND NICHT MACHINO
#
# Jeder Schritt hier startet einen Prozess oder laedt ein Modul. machino darf
# beides nicht, solange die IMP-Pipeline laeuft: fork+exec ist auf dieser
# Kamera der dokumentierte Ausloeser eines Out-of-Memory-Vorfalls. Deshalb
# passiert alles Prozess-Startende VOR machinod -- S42 liegt hinter S41yt8512
# (Ethernet) und weit vor S95streamer.
#
# Praeziser gesagt: hier wird sehr wohl geforkt, das ist der Zweck. Der Punkt
# ist, dass der Prozess mit der grossen IMP-Pipeline es nicht tut. machino
# steuert danach nur noch ueber Sockets und eine Rollendatei.
#
# REIHENFOLGE
#
# Die ist nicht beliebig, sie ist auf Hardware erarbeitet (siehe
# machino/docs/aic8800-bringup.md):
#
#   cfg80211            ist in diesem Kernel NICHT eingebaut, sondern Modul
#   aic_load_fw         liefert Symbole fuer aic8800 (depends=aic_load_fw)
#   aic8800
#   GPIO 50 = PB18      Portstrom ZULETZT: das Geraet taucht auf, wenn der
#                       Treiber schon registriert ist, dann passieren
#                       Enumeration und Binding in einem Zug
#
# Die Module muessen mit CONFIG_PREALLOC_RX_SKB=n gebaut sein. Mit dem
# Upstream-Default fordert der Treiber beim Init 847 order-3-Bloecke an; diese
# Kamera hat rund 20 davon frei, der OOM-Killer trifft den Mediendaemon, und
# der haelt /dev/watchdog. Ergebnis: Reboot.

CONF=/etc/machino/machino.conf
MODDIR=/etc/machino/modules
WPACONF=/etc/machino/wpa-supplicant.conf
CTRL=/var/run/wpa_supplicant
DHCPSCRIPT=/etc/machino/udhcpc-wlan.script
SUPERVISOR=/usr/sbin/machino-wifi-role
ROLEFILE=/etc/machino/wifi-role
IFACE=wlan0
GPIO=50

# WLAN ist optional und standardmaessig AUS.
#
# Die Einstellung steht in machino.conf, weil es genau EINE Wahrheit geben
# soll: dieselbe Datei, die die API schreibt. Eine zweite Markierungsdatei
# waere ein zweiter Zustand, und zwei Zustaende driften.
#
# Gelesen wird hier und nicht von machino, weil machino zu diesem Zeitpunkt
# noch nicht laeuft -- und genau das ist der Sinn der Sache. Ist WLAN aus,
# wird kein Modul geladen, keine Schiene hochgefahren und kein Daemon
# gestartet. Der USB-Port bleibt unberuehrt fuer das, was sonst daran haengt;
# beim T40 ist das spaeter das 4G-Modem, und der aic8800-Treiber ist die
# Komponente, die diese Kamera beim Bring-up zweimal in den OOM getrieben hat.
#
# Der Preis ist ein Neustart beim Umschalten. Der ist ehrlich: das Gegenteil
# waere, Module bei laufender IMP-Pipeline nachzuladen.
# Erst alle Leerzeichen, Tabs und CR raus, dann exakt am Zeilenanfang
# vergleichen. Das ist absichtlich stumpf: eine Variante mit mehreren
# [[:space:]]-Klassen im selben Ausdruck hat sich beim Testen je nach
# sed-Implementierung anders verhalten, und diese Zeile entscheidet, ob ein
# Treiber geladen wird. Ein Kommentar (#usb...), ein Praefix (xusb...) und ein
# Suffix (usb.wifi.enabledx) fallen hier alle korrekt durch. Bei mehrfacher
# Angabe gewinnt die letzte, wie ueberall in dieser Datei.
wifi_enabled() {
	[ -f "$CONF" ] || return 1
	v=$(tr -d ' \t\r' < "$CONF" | sed -n 's/^usb\.wifi\.enabled=//p' | tail -1)
	[ "$v" = "true" ] || [ "$v" = "1" ]
}

load_modules() {
	modprobe cfg80211 2>/dev/null
	for m in aic_load_fw aic8800; do
		lsmod | grep -q "^$m " && continue
		[ -f "$MODDIR/$m.ko" ] || { echo "wifi: $MODDIR/$m.ko fehlt"; return 1; }
		insmod "$MODDIR/$m.ko" || { echo "wifi: $m liess sich nicht laden"; return 1; }
	done
	return 0
}

port_power_on() {
	[ -d /sys/class/gpio/gpio$GPIO ] || echo $GPIO > /sys/class/gpio/export 2>/dev/null
	[ -d /sys/class/gpio/gpio$GPIO ] || { echo "wifi: GPIO $GPIO nicht exportierbar"; return 1; }
	echo out > /sys/class/gpio/gpio$GPIO/direction
	echo 1   > /sys/class/gpio/gpio$GPIO/value
}

wait_for_iface() {
	# Enumeration, Firmware-Upload und Interface-Anlage brauchen auf dieser
	# Box rund drei Sekunden. Feste Wartezeit waere entweder zu kurz oder
	# verschenkt Bootzeit, also wird gepollt.
	n=0
	while [ ! -d /sys/class/net/$IFACE ]; do
		n=$((n + 1))
		[ $n -ge 60 ] && return 1      # 15 s
		usleep 250000 2>/dev/null || sleep 1
	done
	return 0
}

start() {
	if ! wifi_enabled; then
		echo "wifi: aus (usb.wifi.enabled ist nicht true) - kein Modul, kein Portstrom"
		return 0
	fi
	load_modules || return 1
	port_power_on || return 1
	if ! wait_for_iface; then
		echo "wifi: $IFACE erschien nicht - haengt das Modul am Port?"
		return 1
	fi
	ip link set $IFACE up
	echo "wifi: $IFACE bereit"

	# Ab hier besitzt der Rollen-Supervisor das Interface. Er wird EINMAL
	# gestartet -- hier, vor machinod, also bevor IMP existiert -- und startet
	# danach wpa_supplicant oder hostapd, je nachdem was in
	# /etc/machino/wifi-role steht.
	#
	# Warum nicht beide Daemons direkt hier: Station und AP sind auf diesem
	# Radio gegenseitige Rollen. Beide gleichzeitig auf wlan0 ergibt einen
	# Access Point, der hochkommt und Sekunden spaeter wegbricht, weil der
	# Supplicant weiterscannt. Und machino kann sie nicht selbst umschalten,
	# ohne zu forken.
	[ -x "$SUPERVISOR" ] || { echo "wifi: $SUPERVISOR fehlt"; return 1; }
	[ -f "$ROLEFILE" ] || echo station > "$ROLEFILE"
	echo -n "wifi: starte den Rollen-Supervisor: "
	"$SUPERVISOR" >/dev/null 2>&1 &
	echo "$!" > /var/run/machino-wifi-role.pid
	echo "OK (pid $!)"
}

stop() {
	if [ -f /var/run/machino-wifi-role.pid ]; then
		kill "$(cat /var/run/machino-wifi-role.pid)" 2>/dev/null
		rm -f /var/run/machino-wifi-role.pid
	fi
	[ -f /var/run/udhcpc.$IFACE.pid ] && kill "$(cat /var/run/udhcpc.$IFACE.pid)" 2>/dev/null
	rm -f /var/run/udhcpc.$IFACE.pid
	[ -f /var/run/udhcpd.pid ] && kill "$(cat /var/run/udhcpd.pid)" 2>/dev/null
	rm -f /var/run/udhcpd.pid
	# Der Supervisor raeumt seine eigenen Prozesse per PID-Datei ab; hier nur
	# die Faelle, in denen er selbst nicht mehr laeuft.
	for p in /var/run/wpa_supplicant.wlan0.pid /var/run/hostapd.pid; do
		[ -f "$p" ] && { kill "$(cat "$p")" 2>/dev/null; rm -f "$p"; }
	done
	ip link set $IFACE down 2>/dev/null
	# Portstrom bleibt AN. Ihn abzuschalten wuerde das Geraet abmelden,
	# waehrend machino unter Umstaenden noch laeuft und es abfragt.
}

case "$1" in
	start) start ;;
	stop)  stop ;;
	restart) stop; sleep 2; start ;;
	status)
		echo "enabled: $(wifi_enabled && echo ja || echo nein)"
		echo "iface:   $([ -d /sys/class/net/$IFACE ] && echo vorhanden || echo fehlt)"
		echo "modules: $(lsmod | grep -c '^aic') aic-Module geladen"
		echo "role:    $(cat $ROLEFILE 2>/dev/null || echo '-')"
		echo "supplicant: $([ -e $CTRL/$IFACE ] && echo laeuft || echo aus)"
		echo "hostapd:    $([ -e /var/run/hostapd/$IFACE ] && echo laeuft || echo aus)"
		;;
	*) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
