#!/bin/sh
# udhcpc-Hook fuer das Mobilfunk-Interface (usb0 oder wie der Kernel es nennt).
#
# Warum nicht das Standardskript des Images: dessen Default-Route bekommt keine
# Metrik. Auf dieser Kamera ist das heute folgenlos, weil eth0 gar keine
# Default-Route hat -- aber auf einem Board, das ueber Ethernet eine bekommt,
# wuerde die Mobilfunk-Route den Management-Pfad uebernehmen, sobald jemand Mobilfunk
# einschaltet. Das faellt dann niemandem auf, bis das Mobilfunk ausfaellt.
#
# Also: die Mobilfunk-Default-Route bekommt eine SCHLECHTERE Metrik als Ethernet.
# Wer Mobilfunk bevorzugen will, sagt das ueber die Uplink-Policy in machino, nicht
# durch einen Zufall in der Reihenfolge der DHCP-Antworten.
#
# Diese Zahl ist seit AP-M5 nur noch ein STARTWERT fuer das Fenster, bis machino
# konvergiert hat. Danach setzt core/net/route_plan die Metriken aus der
# Uplink-Policy, und die aktive Verbindung bekommt eine niedrigere als jede
# andere. Der Startwert bleibt trotzdem vorsichtig: waere er niedriger als der
# von Ethernet, uebernaehme das Modem in genau diesem Fenster den
# Management-Pfad.
CELL_METRIC=300

# Was machino liest, um zu wissen, ob eine Adresse da ist.
#
# DIESES Skript schreibt sie, nicht der Helfer: nur hier ist der Lease bekannt,
# samt Gateway und DNS, und nur hier weiss jemand, wann er sich aendert. Der
# Helfer fuellt die Datei nur im NIC-Modus, wo es gar kein DHCP gibt.
#
# Das fehlte zuerst -- und damit haette der DHCP-Pfad NIE eine Adresse gemeldet.
# Die Hosttests sahen es nicht: die Attrappe dort erfindet eine Adresse, sobald
# DHCP laeuft, und war damit gutmuetiger als die Wirklichkeit.
STATE=/var/run/machino-cellular.state

write_state() {
	tmp="$STATE.new"
	{
		echo "iface=$interface"
		echo "ipv4=$ip"
		# KEIN netmask: udhcpc liefert in $mask die Praefixlaenge ("24"), das
		# Feld traegt aber sonst die gepunktete Maske aus CGCONTRDP. Zwei
		# Formate unter einem Namen sind eine Falle, und im DHCP-Pfad braucht
		# die Maske ohnehin niemand -- udhcpc hat das Interface schon
		# konfiguriert, bevor dieses Skript laeuft.
		[ -n "$router" ] && echo "gateway=${router%% *}"
		set -- $dns
		[ -n "${1:-}" ] && echo "dns1=$1"
		[ -n "${2:-}" ] && echo "dns2=$2"
		[ -n "$mtu" ]    && echo "mtu=$mtu"
		# ':' MUSS die letzte Anweisung der Gruppe sein. Sonst ist der
		# Exit-Status der Gruppe der des letzten bedingten echo -- und bei
		# leerem $mtu (busybox-udhcpc liefert es meist nicht) ist das die 1 von
		# "[ -n "" ]". Dann greift nicht "&& mv", sondern "|| rm -f": die frisch
		# und vollstaendig geschriebene Datei wird sofort wieder geloescht, und
		# machino sieht NIE eine Adresse mit Gateway/DNS. Genau das war der
		# Teardown-Churn und das leere resolv.conf (Hardware gemessen 2026-09-26).
		:
	} > "$tmp" 2>/dev/null && mv -f "$tmp" "$STATE" 2>/dev/null || rm -f "$tmp"
	# KEIN chmod: der Helfer laeuft mit umask 077 und schreibt dieselbe Datei
	# mit 0600. Zwei Schreiber mit verschiedenen Rechten waeren ein Zustand,
	# der davon abhaengt, wer zuletzt dran war.
}

case "$1" in
	deconfig)
		ip addr flush dev "$interface" 2>/dev/null
		ip link set "$interface" up
		# Keine Adresse mehr -- und machino soll das sehen, statt die alte
		# weiterzumelden.
		rm -f "$STATE"
		;;

	renew|bound)
		# /32, NICHT die Maske des Modems. Das Modem liefert per DHCP ein /8
		# (gemessen 2026-09-29: 37.85.117.0/8). Damit gilt jedes Ziel im
		# gesamten Block des Traegers als direkt erreichbar, die Kamera fragt
		# per ARP auf usb0 statt ueber das Gateway zu senden, und jeder Client
		# mit einer Adresse aus 37.0.0.0/8 ist fuer sie unerreichbar.
		#
		# usb0 ist dabei KEIN Punkt-zu-Punkt-Interface, sondern ein normales
		# Ether-NIC (<BROADCAST,MULTICAST>, gemessen 2026-09-29). Es hat nur
		# genau einen Nachbarn: das Modem, das per ARP fuer das Gateway
		# antwortet (gemessen: 37.85.117.255 -> 00:e4:e4:e4:e4:e4, REACHABLE,
		# dieselbe MAC wie fuer 169.254.0.1). Genau deshalb traegt die Route
		# unten mit `onlink` und einem /32 -- und das /8 mit seinen
		# Muell-Broadcasts 37.0.0.0/37.255.255.255 in `table local` faellt weg.
		#
		# Eine Erneuerung mit unveraenderter Adresse fasst das Interface nicht
		# an: das Flush wuerde jede laufende Verbindung fuer die Dauer des
		# Neusetzens ohne Quelladresse dastehen lassen -- und Mobilfunk
		# erneuert alle paar Minuten.
		if ! ip -4 addr show dev "$interface" 2>/dev/null | grep -q "inet $ip/32 "; then
			ip addr flush dev "$interface" 2>/dev/null
			ip addr add "$ip/32" dev "$interface"
		fi

		if [ -n "$router" ]; then
			r="${router%% *}"
			# Die Default-Route hier ist nur der STARTWERT (siehe oben). Sobald
			# machino konvergiert ist, besitzt route_plan die einzige Route
			# ueber dieses Interface -- mit seiner Metrik, nicht mit 300. Ein
			# Renewal darf die nicht anfassen: "ip route del default dev usb0"
			# ohne Metrik traefe die ERSTE Default-Route auf usb0, also
			# machinos, und der Reconciler muesste alle paar Minuten neu
			# konvergieren. Deshalb: steht schon irgendeine Default-Route ueber
			# dieses Gateway auf diesem Interface, bleibt alles wie es ist.
			# Nur wenn keine da ist (erstes bound, oder ein NEUES Gateway nach
			# einer Neuwahl), raeumt das Skript die alten weg und setzt den
			# Startwert.
			if ! ip -4 route show dev "$interface" 2>/dev/null | grep -q "^default via $r "; then
				# Nur die eigenen loeschen, nicht jede: ein "ip route del
				# default" ohne dev wuerde die Ethernet-Route mitnehmen, und
				# genau das soll dieses Skript verhindern. Mehrere, falls
				# machino und ein aelterer Startwert beide noch stehen.
				while ip route del default dev "$interface" 2>/dev/null; do :; done
				# onlink: das Gateway liegt in keinem Praefix des Interface
				# (es gibt keins ausser dem /32), der Kernel wuerde die Route
				# ohne das Flag mit "Network unreachable" ablehnen.
				ip route add default via "$r" dev "$interface" onlink metric $CELL_METRIC 2>/dev/null
			fi
		fi

		# resolv.conf wird hier NICHT angefasst. Bewusst, und anders als im
		# WLAN-Skript nebenan.
		#
		# Die Datei ist systemweit, es gibt nur eine, und sie gehoert dem
		# Uplink, der den Verkehr traegt. Ein Mobilfunk-Lease erneuert sich
		# alle paar Minuten; schriebe dieses Skript dabei jedes Mal die
		# Resolver des Anbieters hinein, waehrend die Kamera laengst wieder
		# ueber Ethernet redet, liefe die Namensaufloesung ueber eine Strecke,
		# die der Verkehr nicht benutzt -- und niemand koennte sehen, warum
		# Aufloesungen langsam sind. machino entscheidet das zentral
		# (core/net/route_plan) und bekommt die Server aus $STATE weiter unten.
		#
		# Warum das WLAN-Skript es trotzdem darf: wlan0 kann vom Boot-Supervisor
		# hochkommen, ohne dass machino laeuft, und braucht dann selbst eine
		# Notversorgung. Einen Mobilfunk-Lease ohne machino gibt es nicht --
		# die ECM-Zustandsmaschine startet den DHCP-Client ueberhaupt erst.

		# ZULETZT: erst wenn Adresse und Route wirklich stehen, darf
		# machino "verbunden" lesen. Andersherum meldete der Zustand eine
		# Verbindung, waehrend die Route noch fehlte.
		write_state
		;;

	leasefail|nak)
		# Keine Adresse. Das Interface NICHT abraeumen -- der Supplicant kann
		# gerade mitten in einer Re-Assoziation stecken (etwa nach einem
		# Rollback), und udhcpc versucht es mit -t 0 ohnehin weiter.
		;;
esac

exit 0
