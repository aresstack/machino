#!/bin/sh
# udhcpc-Hook fuer das Mobilfunk-Interface (usb0 oder wie der Kernel es nennt).
#
# Warum nicht das Standardskript des Images: dessen Default-Route bekommt keine
# Metrik. Auf dieser Kamera ist das heute folgenlos, weil eth0 gar keine
# Default-Route hat -- aber auf einem Board, das ueber Ethernet eine bekommt,
# wuerde die Mobilfunk-Route den Management-Pfad uebernehmen, sobald jemand Mobilfunk
# einschaltet. Das faellt dann niemandem auf, bis das Mobilfunk ausfaellt.
#
# Also: die Mobilfunk-Default-Route bekommt eine SCHLECHTERE Metrik als Ethernet.
# Wer Mobilfunk bevorzugen will, sagt das ueber die Uplink-Policy in machino, nicht
# durch einen Zufall in der Reihenfolge der DHCP-Antworten.
CELL_METRIC=300

RESOLV=/etc/resolv.conf

# Was machino liest, um zu wissen, ob eine Adresse da ist.
#
# DIESES Skript schreibt sie, nicht der Helfer: nur hier ist der Lease bekannt,
# samt Gateway und DNS, und nur hier weiss jemand, wann er sich aendert. Der
# Helfer fuellt die Datei nur im NIC-Modus, wo es gar kein DHCP gibt.
#
# Das fehlte zuerst -- und damit haette der DHCP-Pfad NIE eine Adresse gemeldet.
# Die Hosttests sahen es nicht: die Attrappe dort erfindet eine Adresse, sobald
# DHCP laeuft, und war damit gutmuetiger als die Wirklichkeit.
STATE=/var/run/machino-cellular.state

write_state() {
	tmp="$STATE.new"
	{
		echo "iface=$interface"
		echo "ipv4=$ip"
		# KEIN netmask: udhcpc liefert in $mask die Praefixlaenge ("24"), das
		# Feld traegt aber sonst die gepunktete Maske aus CGCONTRDP. Zwei
		# Formate unter einem Namen sind eine Falle, und im DHCP-Pfad braucht
		# die Maske ohnehin niemand -- udhcpc hat das Interface schon
		# konfiguriert, bevor dieses Skript laeuft.
		[ -n "$router" ] && echo "gateway=${router%% *}"
		set -- $dns
		[ -n "${1:-}" ] && echo "dns1=$1"
		[ -n "${2:-}" ] && echo "dns2=$2"
		[ -n "$mtu" ]    && echo "mtu=$mtu"
	} > "$tmp" 2>/dev/null && mv -f "$tmp" "$STATE" 2>/dev/null || rm -f "$tmp"
	# KEIN chmod: der Helfer laeuft mit umask 077 und schreibt dieselbe Datei
	# mit 0600. Zwei Schreiber mit verschiedenen Rechten waeren ein Zustand,
	# der davon abhaengt, wer zuletzt dran war.
}

case "$1" in
	deconfig)
		ip addr flush dev "$interface" 2>/dev/null
		ip link set "$interface" up
		# Keine Adresse mehr -- und machino soll das sehen, statt die alte
		# weiterzumelden.
		rm -f "$STATE"
		;;

	renew|bound)
		ip addr flush dev "$interface" 2>/dev/null
		ip addr add "$ip/$mask" ${broadcast:+broadcast $broadcast} dev "$interface"

		if [ -n "$router" ]; then
			# Nur die eigene loeschen, nicht jede: ein "ip route del default"
			# ohne dev wuerde die Ethernet-Route mitnehmen, und genau das soll
			# dieses Skript verhindern.
			ip route del default dev "$interface" 2>/dev/null
			for r in $router; do
				ip route add default via "$r" dev "$interface" metric $CELL_METRIC 2>/dev/null
			done
		fi

		# resolv.conf nur ergaenzen, wenn wir wirklich Server bekommen haben.
		# Die Datei leer zu schreiben, weil eine Antwort keine DNS enthielt,
		# nimmt dem Rest des Systems die Namensaufloesung.
		if [ -n "$dns" ]; then
			tmp="$RESOLV.cellular.$$"
			{
				grep -v '^# machino-cellular$' "$RESOLV" 2>/dev/null | grep -v '^nameserver'
				for d in $dns; do echo "nameserver $d"; done
				echo '# machino-cellular'
			} > "$tmp" || { rm -f "$tmp"; exit 0; }
			# Rechte AUSDRUECKLICH setzen, nicht dem umask ueberlassen.
			#
			# Der Rollen-Supervisor laeuft mit umask 077, damit die
			# wpa_supplicant-Konfiguration mit ihrem PSK nicht lesbar entsteht.
			# Dieses Skript ist sein Enkelkind und erbt das -- die Temp-Datei
			# entstuende als 0600, und der mv wuerde eine 0644-Systemdatei
			# heimlich auf root-only herabstufen. Auf dieser Kamera laeuft alles
			# als root, es faellt also nicht auf; genau deshalb waere es spaeter
			# nicht zu finden. resolv.conf ist kein Geheimnis.
			chmod 0644 "$tmp" 2>/dev/null
			mv "$tmp" "$RESOLV" || rm -f "$tmp"
		fi

		# ZULETZT: erst wenn Adresse, Route und DNS wirklich stehen, darf
		# machino "verbunden" lesen. Andersherum meldete der Zustand eine
		# Verbindung, waehrend die Route noch fehlte.
		write_state
		;;

	leasefail|nak)
		# Keine Adresse. Das Interface NICHT abraeumen -- der Supplicant kann
		# gerade mitten in einer Re-Assoziation stecken (etwa nach einem
		# Rollback), und udhcpc versucht es mit -t 0 ohnehin weiter.
		;;
esac

exit 0
