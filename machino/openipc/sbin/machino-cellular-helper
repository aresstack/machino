#!/bin/sh
# Der kleine Prozessstarter fuer den Mobilfunk-Datenpfad.
#
# WARUM ES IHN GIBT
#
# Dieselbe Begruendung wie beim WLAN-Rollen-Supervisor: machino darf bei
# laufender IMP-Pipeline nicht fork+exec -- das ist auf dieser Kamera der
# dokumentierte Ausloeser eines Out-of-Memory-Vorfalls, und der OOM-Killer
# trifft den Mediendaemon, der /dev/watchdog haelt. Also schreibt machino einen
# Wunsch in eine Datei, und dieser Prozess fuehrt ihn aus. Er hat ein paar
# hundert Kilobyte RSS; ein fork() aus ihm heraus ist harmlos.
#
# Praezise gesagt: hier wird sehr wohl geforkt. Der Punkt ist, WER es tut.
#
# PROTOKOLL
#
# machino schreibt EINE Zeile nach $REQ (atomar ueber rename):
#
#   dhcp <iface>                          DHCP-Client starten
#   static <iface> <ip> <mask> [gw] [dns1] [dns2]
#                                         Adresse fest setzen (NIC-Modus: das
#                                         Modem beantwortet kein DHCP)
#   up <iface> | down <iface>             Interface administrativ schalten
#   stop <iface>                          alles zu diesem Interface abraeumen
#   ppp-start <optionsdatei>              pppd mit diesen Optionen starten
#   ppp-stop                              pppd beenden
#
# Dieser Helfer schreibt nach $STATE, was tatsaechlich konfiguriert ist:
#
#   iface=usb0
#   ipv4=...  netmask=...  gateway=...  dns1=...  dns2=...
#
# NUR das eigene Interface. Keine fremden Routen, keine fremden Prozesse.

REQ=/etc/machino/cellular-dhcp
STATE=/var/run/machino-cellular.state
PIDDIR=/var/run
DHCPSCRIPT=/etc/machino/udhcpc-cellular.script
LOGFILE=/tmp/machino-cellular.log
POLL=2

log() { echo "cellular: $*"; echo "$(date '+%H:%M:%S') cellular: $*" >> "$LOGFILE" 2>/dev/null; }

pidfile_for() { echo "$PIDDIR/udhcpc.$1.pid"; }

# Nur den EIGENEN Prozess beenden, nie per killall, und auf sein Ende warten --
# kill(1) kehrt zurueck, wenn das Signal zugestellt ist, nicht wenn der
# Empfaenger fertig ist. Beim WLAN hat genau das einen Rollenwechsel zerlegt.
kill_pidfile() {
	[ -f "$1" ] || return 0
	pid=$(cat "$1" 2>/dev/null)
	rm -f "$1"
	[ -n "$pid" ] || return 0
	kill "$pid" 2>/dev/null || return 0
	n=0
	while kill -0 "$pid" 2>/dev/null; do
		n=$((n + 1))
		if [ $n -ge 50 ]; then kill -9 "$pid" 2>/dev/null; sleep 1; break; fi
		usleep 100000 2>/dev/null || sleep 1
	done
}

write_state() {
	umask 077
	tmp="$STATE.new"
	{
		echo "iface=$1"
		[ -n "$2" ] && echo "ipv4=$2"
		[ -n "$3" ] && echo "netmask=$3"
		[ -n "$4" ] && echo "gateway=$4"
		[ -n "$5" ] && echo "dns1=$5"
		[ -n "$6" ] && echo "dns2=$6"
	} > "$tmp" && mv -f "$tmp" "$STATE" || rm -f "$tmp"
}

clear_state() { rm -f "$STATE"; }

# Die Default-Route dieses Interface, und nur diese. `ip route del default`
# ohne dev loescht die erste gefundene -- das kann die von Ethernet sein, und
# dann ist die Kamera weg.
del_own_default() {
	[ -n "$1" ] || return 0
	ip route del default dev "$1" 2>/dev/null
}

stop_iface() {
	iface=$1
	kill_pidfile "$(pidfile_for "$iface")"
	del_own_default "$iface"
	ip addr flush dev "$iface" 2>/dev/null
	# Auch herunternehmen. machino schickt dafuer KEINEN eigenen Wunsch: das
	# Protokoll ist eine Zeile, und ein "down" direkt nach einem "stop" haette
	# das "stop" ueberschrieben, bevor dieser Prozess es gelesen haette.
	ip link set "$iface" down 2>/dev/null
	clear_state
	log "$iface abgeraeumt"
}

# ------------------------------------------------------------------- PPP ----
#
# Der Alternativpfad aus AP-M7. ECM bleibt der Normalfall; PPP ist fuer Modems
# und Netze, in denen ECM nicht geht.
#
# machino schreibt die pppd-Optionen (samt Chat-Skript) selbst und schickt hier
# nur den Pfad. Dieser Prozess startet pppd und merkt sich, WIE er aufgehoert
# hat -- der Exit-Code ist der einzige Unterschied zwischen "Passwort falsch",
# "kein CONNECT" und "Gegenstelle hat aufgelegt", und ohne ihn sieht in der
# Oberflaeche alles gleich aus.
PPP_PIDFILE=/var/run/pppd.pid
PPP_STATUS=/var/run/machino-ppp.status

# Gehoert diese PID noch dem Programm, das wir beenden wollen?
#
# Eine PID-Datei ist ein Zettel, kein Besitznachweis. Beendet sich pppd selbst
# -- abgelehnte Authentifizierung, NO CARRIER, Linkverlust -- und bleibt der
# Zettel liegen, vergibt der Kernel die Nummer irgendwann neu. Ein spaeteres
# stop schoesse dann auf einen fremden Prozess, und auf dieser Kamera laeuft
# alles als root: das kann der Mediendaemon sein.
#
# Der Zettel wird nach einem natuerlichen Ende zwar entfernt (siehe start_ppp),
# aber genau dafuer, dass das einmal NICHT passiert -- Stromausfall zwischen
# wait und rm, ein Kill der Subshell --, steht diese Pruefung hier.
#
# procfs ist der Testhaken: $PROCDIR ist in Produktion /proc. Ein LEERER
# cmdline-Inhalt heisst "procfs sagt dazu nichts" und wird als "darf" gewertet;
# unter Linux hat jeder normale Prozess dort Inhalt, und ein Kernel-Thread
# liesse sich ohnehin nicht beenden.
PROCDIR=/proc

# Die eigene PID-Datei abraeumen -- und NUR die eigene.
#
# Ohne das Entfernen bliebe nach jedem natuerlichen Ende von pppd ein Zettel
# mit einer toten PID liegen, und sobald der Kernel die Nummer neu vergibt,
# schoesse ein spaeteres stop auf einen fremden Prozess.
#
# Ohne den Vergleich waere es andersherum falsch: hat inzwischen ein NEUER
# Anruf die Datei uebernommen, gehoert sie schon ihm, und der alte Waiter
# loeschte den Zettel des Nachfolgers -- der waere dann nicht mehr beendbar.
#
# Eine eigene Funktion, damit ein Test sie aufrufen kann. Als Zeile in der
# Subshell liess sie sich nur nachbauen, und ein Test, der die Logik nachbaut
# statt sie auszufuehren, bleibt gruen, wenn man sie aus dem Skript entfernt.
release_pidfile() {
	[ "$(cat "$1" 2>/dev/null)" = "$2" ] && rm -f "$1"
	return 0
}

pid_is_named() {
	_pn_pid=$1; _pn_name=$2
	case "$_pn_pid" in ''|*[!0-9]*) return 1 ;; esac
	[ "$_pn_pid" -gt 1 ] 2>/dev/null || return 1
	_pn_cmd=$(tr '\000' ' ' < "$PROCDIR/$_pn_pid/cmdline" 2>/dev/null)
	[ -n "$_pn_cmd" ] || return 0
	case "$_pn_cmd" in *"$_pn_name"*) return 0 ;; *) return 1 ;; esac
}

write_ppp_status() {
	tmp="$PPP_STATUS.new"
	{
		echo "running=$1"
		[ -n "${2:-}" ] && echo "exit=$2"
		[ -n "${3:-}" ] && echo "detail=$3"
	} > "$tmp" 2>/dev/null && mv -f "$tmp" "$PPP_STATUS" 2>/dev/null || rm -f "$tmp"
}

stop_ppp() {
	_sp_pid=$(cat "$PPP_PIDFILE" 2>/dev/null)
	if [ -n "$_sp_pid" ] && ! pid_is_named "$_sp_pid" pppd; then
		# Der Zettel ist alt und die Nummer gehoert inzwischen jemand anderem.
		# Wegwerfen, NICHT darauf schiessen.
		log "pid $_sp_pid ist kein pppd mehr - stale PID-Datei verworfen"
		rm -f "$PPP_PIDFILE"
	else
		kill_pidfile "$PPP_PIDFILE"
	fi
	# Der Zustand wird hier NICHT auf "beendet mit Fehler" gesetzt: wir haben
	# beendet, und das ist kein Fehlschlag. Der wartende Subshell schreibt
	# gleich exit=5 (SIGTERM), was machino als "ok" liest.
	clear_state
}

start_ppp() {
	opts=$1
	command -v pppd >/dev/null 2>&1 || {
		log "kein pppd im Image"
		write_ppp_status 0 127 "pppd ist auf diesem Image nicht installiert"
		return 1
	}
	[ -r "$opts" ] || { log "$opts fehlt"; write_ppp_status 0 2 "keine pppd-Optionen"; return 1; }
	stop_ppp

	write_ppp_status 1
	# Die Subshell ist pppds ELTERNPROZESS, und nur deshalb kann sie seinen
	# Exit-Code lesen: `wait` funktioniert ausschliesslich fuer eigene Kinder.
	# Ein Geschwisterprozess koennte nur mit `kill -0` pollen und wuesste am
	# Ende nur DASS, nicht WARUM.
	#
	# In die PID-Datei kommt pppds echte PID, nicht die der Subshell -- sonst
	# beendete kill_pidfile die Huelle und liesse pppd auf dem Modem-Port
	# stehen.
	(
		pppd file "$opts" nodetach >>"$LOGFILE" 2>&1 &
		_p=$!
		echo "$_p" > "$PPP_PIDFILE"
		wait "$_p"
		# Den Exit-Code ZUERST sichern: alles danach ueberschreibt $?.
		_rc=$?
		release_pidfile "$PPP_PIDFILE" "$_p"
		write_ppp_status 0 "$_rc"
	) &
	log "pppd gestartet (Optionen: $opts)"
}

start_dhcp() {
	iface=$1
	command -v udhcpc >/dev/null 2>&1 || { log "kein udhcpc im Image"; return 1; }
	kill_pidfile "$(pidfile_for "$iface")"
	ip link set "$iface" up 2>/dev/null
	# -f und selbst in den Hintergrund: mit -b zusammen mit -t 0 geht udhcpc
	# NIE in den Hintergrund ("background if lease is not obtained" tritt bei
	# unbegrenzten Versuchen nicht ein) und haengt den Aufrufer fest. Genau das
	# hat beim WLAN den Supervisor lahmgelegt.
	if [ -x "$DHCPSCRIPT" ]; then
		udhcpc -f -i "$iface" -t 0 -S -s "$DHCPSCRIPT" >>"$LOGFILE" 2>&1 &
	else
		udhcpc -f -i "$iface" -t 0 -S >>"$LOGFILE" 2>&1 &
	fi
	echo "$!" > "$(pidfile_for "$iface")"
	log "DHCP auf $iface gestartet (pid $!)"
}

set_static() {
	iface=$1; ip4=$2; mask=$3; gw=$4; d1=$5; d2=$6
	# Im NIC-Modus gibt es keinen DHCP-Server -- ein laufender Client haette
	# hier nichts zu tun und wuerde nur die Adresse wieder abraeumen.
	kill_pidfile "$(pidfile_for "$iface")"
	ip link set "$iface" up 2>/dev/null
	ip addr flush dev "$iface" 2>/dev/null
	ip addr add "$ip4/$(mask_to_prefix "$mask")" dev "$iface" 2>/dev/null
	if [ -n "$gw" ]; then
		del_own_default "$iface"
		# Metrik 300: hoeher als Ethernet (0) und WLAN (200). Mobilfunk ist der
		# teuerste Weg ins Netz und soll nicht ungefragt der bevorzugte sein --
		# die Reihenfolge entscheidet spaeter machinos Uplink-Politik, aber
		# solange sie das nicht tut, ist die vorsichtige Metrik die richtige.
		ip route add default via "$gw" dev "$iface" metric 300 2>/dev/null
	fi
	write_state "$iface" "$ip4" "$mask" "$gw" "$d1" "$d2"
	log "$iface statisch: $ip4/$mask gw=$gw"
}

# 255.255.255.240 -> 28
mask_to_prefix() {
	[ -n "$1" ] || { echo 24; return; }
	n=0
	IFS=. read a b c d <<EOF
$1
EOF
	for o in $a $b $c $d; do
		case "$o" in
			255) n=$((n + 8)) ;; 254) n=$((n + 7)) ;; 252) n=$((n + 6)) ;;
			248) n=$((n + 5)) ;; 240) n=$((n + 4)) ;; 224) n=$((n + 3)) ;;
			192) n=$((n + 2)) ;; 128) n=$((n + 1)) ;; 0) ;;
			*) echo 24; return ;;
		esac
	done
	echo $n
}

# ---------------------------------------------------------------- main loop
umask 077
: > "$LOGFILE"
last=""
while :; do
	if [ -f "$REQ" ]; then
		req=$(cat "$REQ" 2>/dev/null | tr -d '\r')
	else
		req=""
	fi
	if [ "$req" != "$last" ]; then
		last="$req"
		set -- $req
		verb=$1; iface=$2
		case "$verb" in
			dhcp)   [ -n "$iface" ] && start_dhcp "$iface" ;;
			static) [ -n "$iface" ] && set_static "$2" "$3" "$4" "$5" "$6" "$7" ;;
			up)     [ -n "$iface" ] && { ip link set "$iface" up 2>/dev/null; log "$iface up"; } ;;
			down)   [ -n "$iface" ] && { ip link set "$iface" down 2>/dev/null; log "$iface down"; } ;;
			stop)   [ -n "$iface" ] && stop_iface "$iface" ;;
			# Beim PPP-Pfad ist das zweite Wort kein Interface, sondern der
			# Pfad der Optionsdatei -- das Interface heisst dort pppX und
			# entsteht erst, wenn die Aushandlung durch ist.
			ppp-start) [ -n "$iface" ] && start_ppp "$iface" ;;
			ppp-stop)  stop_ppp ;;
			"")     ;;
			*)      log "unbekannter Wunsch '$verb' - ignoriert" ;;
		esac
	fi
	sleep $POLL
done
