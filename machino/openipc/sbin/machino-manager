#!/bin/sh
# machino-manager: one idempotent control surface for tools (the Cam-Tool) and
# humans. It hides which files Machino owns behind three operations:
#
#   machino-manager install [--owner NAME] [--platform P] [--with-pages] [--minimal]
#   machino-manager uninstall [--owner NAME] [--force]
#   machino-manager status            # machine-readable JSON on stdout
#
# The truth about "is Machino on?" is always derived LIVE here (binary, version,
# init script, config, ownership manifest) - never from a cached UI value. A
# versioned ownership manifest (install-state.json) records that WE installed it,
# so uninstall refuses to delete an installation it does not own (EXTERNAL).
set -u

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT="${MACHINO_ROOT:-}"            # test hook, see install.sh
STATE_DIR="$ROOT/etc/machino"
BIN="$ROOT/usr/bin/machino"
INITD="$ROOT/etc/init.d"
STREAMERCTL="$ROOT/usr/sbin/streamerctl"
MANIFEST="$STATE_DIR/install-state.json"
SCHEMA=1
PRODUCT=machino
# The machino daemon's argv0 is its full path, so it is matched by path, never
# "pgrep -x machino" (the lesson from the M11a bring-up). Keep this identical to
# streamerctl/init/uninstall.
DAEMON_PATH="${BIN:-/usr/bin/machino}"
[ -n "$ROOT" ] && DAEMON_PATH="/usr/bin/machino"   # on-camera the daemon runs from the absolute path

say()  { echo "$*"; }
warn() { echo "machino-manager: $*" >&2; }
die()  { echo "machino-manager: $*" >&2; exit 1; }

# machino-manager ships in the bundle's sbin/, so its siblings install.sh /
# uninstall.sh live one directory up; on the camera the stored uninstaller is
# under $STATE_DIR. Look in all of them.
find_script() {  # name -> path on stdout, or empty
    for d in "$HERE" "$HERE/.." "$STATE_DIR"; do
        [ -f "$d/$1" ] && { echo "$d/$1"; return 0; }
    done
    return 1
}

# ---- live detection --------------------------------------------------------
bin_ok()      { [ -x "$BIN" ]; }
init_ok()     { [ -f "$INITD/machino" ]; }
conf_ok()     { [ -f "$STATE_DIR/machino.conf" ]; }
manifest_ok() { [ -f "$MANIFEST" ]; }
version()     { [ -x "$BIN" ] && "$BIN" --version 2>/dev/null | awk 'NR==1{print $2}'; }
running()     { pgrep -f "$DAEMON_PATH" >/dev/null 2>&1; }

# a flat JSON reader good enough for the fields we write ourselves
manifest_get() {
    [ -f "$MANIFEST" ] || return 1
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p;
            s/.*"'"$1"'"[[:space:]]*:[[:space:]]*\(true\|false\|[0-9][0-9]*\).*/\1/p' "$MANIFEST" | head -n1
}

selected() { [ -f "$STATE_DIR/streamer" ] && cat "$STATE_DIR/streamer" || echo unknown; }

# OFF      - nothing installed
# ON       - our manifest + every component healthy + Machino is the SELECTED
#            streamer AND actually running (truly active, not just "files present")
# BROKEN   - our manifest present but any of the ON conditions is missing/failing
# EXTERNAL - Machino present but NOT installed by us (no manifest): do not touch
compute_state() {
    if manifest_ok; then
        if bin_ok && [ -n "$(version)" ] && init_ok && conf_ok && [ "$(selected)" = machino ] && running; then
            echo ON
        else
            echo BROKEN
        fi
    else
        if bin_ok || init_ok; then echo EXTERNAL; else echo OFF; fi
    fi
}

emit_status() {
    # Compute the expensive probes ONCE (version spawns the binary; running
    # spawns pgrep) - cheaper for the tool and much faster in the host tests.
    _ver=$(version)
    _run=false; running && _run=true
    _sel=$(selected)
    _bin=false; bin_ok && _bin=true
    _init=false; init_ok && _init=true
    _conf=false; conf_ok && _conf=true
    _man=false; manifest_ok && _man=true
    _vok=false; [ -n "$_ver" ] && _vok=true

    if [ "$_man" = true ]; then
        if [ "$_bin" = true ] && [ "$_vok" = true ] && [ "$_init" = true ] && [ "$_conf" = true ] && [ "$_sel" = machino ] && [ "$_run" = true ]; then
            _state=ON
        else
            _state=BROKEN
        fi
    else
        if [ "$_bin" = true ] || [ "$_init" = true ]; then _state=EXTERNAL; else _state=OFF; fi
    fi

    _mb=$(manifest_get managedBy 2>/dev/null)
    _plat=$(manifest_get platform 2>/dev/null)
    _mwe=$(manifest_get majesticWasEnabled 2>/dev/null); [ -n "$_mwe" ] || _mwe="false"
    printf '{"schema":%s,"product":"%s","state":"%s","version":"%s","platform":"%s","managedBy":"%s","selected":"%s","running":%s,"majesticWasEnabled":%s,"components":{"binary":%s,"version":%s,"init":%s,"config":%s,"manifest":%s}}\n' \
        "$SCHEMA" "$PRODUCT" "$_state" "$_ver" "$_plat" "$_mb" "$_sel" "$_run" "$_mwe" "$_bin" "$_vok" "$_init" "$_conf" "$_man"
}

write_manifest() {  # owner platform
    _owner=$1; _platform=$2
    _ver=$(version)
    _mwe=false
    [ "$(cat "$STATE_DIR/streamer.preinstall" 2>/dev/null)" = "majestic-auto" ] && _mwe=true
    _now=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "")
    mkdir -p "$STATE_DIR"
    cat > "$MANIFEST" <<EOF
{
  "schema": $SCHEMA,
  "managedBy": "$_owner",
  "product": "$PRODUCT",
  "version": "$_ver",
  "platform": "$_platform",
  "majesticWasEnabled": $_mwe,
  "installedAt": "$_now"
}
EOF
    chmod 0644 "$MANIFEST" 2>/dev/null || true
}

cmd_install() {
    owner=cam-tool; platform=""; pages=0; nowifi=0; nocell=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --owner)    shift; owner="${1:-cam-tool}" ;;
            --platform) shift; platform="${1:-}" ;;
            # Ausdrueckliche Option, NICHT der Normalfall: siehe die
            # Begruendung an der Aufrufstelle weiter unten.
            --with-pages) pages=1 ;;
            # Die USB-Nutzlast (WLAN-Treiber, Firmware, hostapd, Modem-Module)
            # ist rund 2,4 MB und liegt DAUERHAFT unter /etc/machino/payload --
            # sie ueberlebt ein uninstall absichtlich, damit ein angelerntes
            # Geraet eine Neuinstallation uebersteht. Auf einer Kamera mit
            # wenigen Megabyte Overlay entscheidet genau das darueber, ob die
            # Installation ueberhaupt passt, und wer weder WLAN noch Modem
            # benutzt, soll dafuer nicht bezahlen.
            #
            # install.sh kann das seit jeher. Nur kam man durch den Manager
            # nicht daran, und die Cam-Tool-Installation laeuft ausschliesslich
            # ueber den Manager -- also war die Nutzlast dort nicht abwaehlbar.
            --without-wifi-payload)     nowifi=1 ;;
            --without-cellular-payload) nocell=1 ;;
            --minimal)                  nowifi=1; nocell=1 ;;
            *) die "install: unknown option '$1'" ;;
        esac
        shift
    done
    INSTALL_SH=$(find_script install.sh) || die "install must be run from the Machino deployment bundle (install.sh not found)"

    # install takes over ANY existing state (OFF / BROKEN / EXTERNAL): the
    # toggle's contract is "ON = our bundle installed and active". install.sh
    # never clobbers an existing machino.conf, and afterwards the ownership
    # manifest makes the install ours. Ownership only gates UNINSTALL.
    # A running daemon must stop first - overwriting a running ELF fails with
    # ETXTBSY. (Skipped under the NO_ACTIVATE test hook: no real daemon there.)
    if [ -z "${MACHINO_MANAGER_NO_ACTIVATE:-}" ] && [ -x "$BIN" ] && running; then
        say "stopping the running machino before replacing its binary" >&2
        [ -x "$INITD/machino" ] && MACHINO_ROOT="$ROOT" "$INITD/machino" stop >/dev/null 2>&1
        _i=0
        while running && [ "$_i" -lt 15 ]; do
            [ "$_i" -eq 5 ] && kill $(pgrep -f "$DAEMON_PATH") 2>/dev/null
            _i=$((_i + 1))
            sleep 1
        done
        running && die "machino is still running and would not stop; cannot replace its binary"
    fi

    # KEINE Menueeintraege im Normalfall. Das ist eine Architekturgrenze, keine
    # Vorsichtsmassnahme:
    #
    #   OpenIPC bleibt unveraendert. Majestic raus, Machino rein.
    #
    # Eine <li>-Zeile in p/header.cgi ist eine Aenderung an der OpenIPC-WebUI,
    # auch wenn sie markiert ist und der Deinstallierer sie byteweise wieder
    # zuruecknimmt. Machino liefert seine Seiten selbst aus und bleibt damit
    # von den Dateien des Wirtssystems getrennt:
    #
    #   http://<kamera>/machino/devices
    #   http://<kamera>/machino/net
    #
    # --with-pages gibt es weiterhin, als ausdrueckliche Entscheidung dessen,
    # der installiert. Sollte OpenIPC einmal einen echten Erweiterungspunkt
    # fuer Menueeintraege anbieten, gehoert die Integration dorthin -- nicht in
    # ein sed auf eine fremde Datei.
    _pageopts=""
    [ "$pages" = "1" ] && _pageopts="--with-network-page --with-device-page"
    [ "$nowifi" = "1" ] && _pageopts="$_pageopts --without-wifi-payload"
    [ "$nocell" = "1" ] && _pageopts="$_pageopts --without-cellular-payload"
    # shellcheck disable=SC2086 -- feste Schalter, kein Benutzertext
    MACHINO_ROOT="$ROOT" sh "$INSTALL_SH" $_pageopts || die "install.sh failed"

    # install.sh has placed the on-camera control surface (machino-manager) and
    # a stored uninstaller under $STATE_DIR already.

    # Activate: switch the camera to Machino now. A failure here is NOT a warning
    # we shrug off - "installed" must mean "active", or the toggle would show a
    # false green. The test hook MACHINO_MANAGER_NO_ACTIVATE simulates the
    # selection switch without a real streamer (host tests have no daemon).
    if [ -n "${MACHINO_MANAGER_NO_ACTIVATE:-}" ]; then
        printf 'machino\n' > "$STATE_DIR/streamer"
    elif [ -x "$STREAMERCTL" ]; then
        MACHINO_ROOT="$ROOT" "$STREAMERCTL" set machino || warn "streamerctl could not switch to machino"
    fi

    write_manifest "$owner" "$platform"

    # Verify it is truly active (selected + running), not merely present.
    state=$(compute_state)
    if [ "$state" != "ON" ]; then
        # AP21: a new daemon that installs cleanly and then will not run is the
        # failure this rollback exists for - the camera is reachable, the
        # binary is whole, and it still does not stream. install.sh kept the
        # previous daemon next door; putting it back costs one rename and is
        # strictly better than leaving a camera on a build that just proved it
        # does not work here.
        #
        # Only attempted when the spare is actually there (install.sh says so
        # when it could not keep one), and the result is REPORTED either way:
        # a silent rollback would make the next person debug the wrong binary.
        prev="$STATE_DIR/backup/machino.prev"
        if [ -f "$prev" ]; then
            warn "post-install verification failed: state=$state - rolling back to the previous daemon"
            if cp -p "$prev" "$BIN.rollback.$$" && chmod 0755 "$BIN.rollback.$$" && mv -f "$BIN.rollback.$$" "$BIN"; then
                if [ -x "$INITD/machino" ]; then
                    MACHINO_ROOT="$ROOT" "$INITD/machino" start >/dev/null 2>&1
                fi
                # The manifest was written a few lines up with the version of
                # the binary that just failed. Leaving it would make the
                # manifest claim a build that is no longer on disk - the exact
                # silent lie this file exists to avoid - so it is rewritten
                # from the daemon that is actually installed now.
                write_manifest "$owner" "$platform"
                state=$(compute_state)
                if [ "$state" = "ON" ]; then
                    warn "rolled back: the previous daemon is running again. The new bundle was NOT kept."
                else
                    warn "rolled back the binary, but the camera is still $state - this needs a look on the device."
                fi
            else
                rm -f "$BIN.rollback.$$"
                warn "rollback failed: $prev could not be restored. The new binary is in place and not running."
            fi
        else
            warn "post-install verification failed: state=$state (Machino is installed but not active)"
            warn "no rollback target at $prev - the previous daemon was not kept."
        fi
        emit_status
        exit 1
    fi
    say "Machino installed and active (owner=$owner platform=${platform:-unknown})." >&2
    emit_status
}

cmd_uninstall() {
    owner=""; force=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --owner) shift; owner="${1:-}" ;;
            --force) force=1 ;;
            *) die "uninstall: unknown option '$1'" ;;
        esac
        shift
    done

    if ! manifest_ok; then
        if bin_ok || init_ok; then
            [ "$force" = "1" ] || die "Machino is present but has no ownership manifest (EXTERNAL); refusing. Use --force to remove anyway."
        else
            say "Machino is not installed; nothing to do." >&2
            emit_status; return 0
        fi
    elif [ -n "$owner" ] && [ "$force" != "1" ]; then
        mb=$(manifest_get managedBy)
        [ "$mb" = "$owner" ] || die "installation is owned by '$mb', not '$owner'; refusing (use --force)."
    fi

    U=$(find_script uninstall.sh) || die "uninstall.sh not found (redeploy the bundle)"
    MACHINO_ROOT="$ROOT" sh "$U" || die "uninstall.sh failed"
    rm -f "$MANIFEST" "$ROOT/usr/sbin/machino-manager" 2>/dev/null || true

    state=$(compute_state)
    [ "$state" = "OFF" ] || warn "after uninstall the state is '$state' (expected OFF)"
    say "Machino removed; Majestic restored to its pre-install state." >&2
    emit_status
}

case "${1:-}" in
    install)   shift; cmd_install "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    status)    emit_status ;;
    -h|--help|"")
        cat >&2 <<EOF
usage: machino-manager <command>
  install [--owner NAME] [--platform P] [--with-pages]
          [--without-wifi-payload] [--without-cellular-payload] [--minimal]
            --with-pages: also add the machino entries to the stock WebUI
            menu. OFF by default - the deploy does not touch OpenIPC's
            files. The pages are reachable at /machino/net and
            /machino/devices either way.
            --without-*-payload / --minimal: do not install the USB payload
            (WiFi driver + firmware + hostapd, modem modules + helper), about
            2.4 MB that stays under /etc/machino/payload across an uninstall.
            On a camera with a small overlay this is the difference between
            fitting and not fitting. Passed straight to install.sh.
  uninstall [--owner NAME] [--force]
  status        machine-readable JSON: state = OFF|ON|BROKEN|EXTERNAL
EOF
        [ "${1:-}" = "" ] && exit 2 || exit 0 ;;
    *) die "unknown command '${1:-}' (try --help)" ;;
esac
