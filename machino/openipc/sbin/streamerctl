#!/bin/sh
# streamerctl - select the media owner on an OpenIPC camera.
#
# Machino and Majestic may both be installed, but never both own the media
# hardware: on a T40NN a second owner has been observed to reset the board.
# This script is the single place that switches between them, and it is
# deliberately NOT part of the Machino daemon: when Majestic is active and
# Machino is stopped, a Machino web API could not be reached to switch back.
#
# Majestic also serves the OpenIPC WebUI on port 80 (system.webPort, staticDir
# /var/www). Stopping it therefore takes the WebUI down with it - including the
# page you would use to switch back. So while Machino is the selected owner it
# becomes the front door on port 80 itself: it answers the Majestic-facing
# routes (/metrics, /api/v1/*, later /ws/video) natively and relays every other
# request to busybox httpd, which serves the stock OpenIPC WebUI privately on
# 127.0.0.1:85. To the stock WebUI, Machino behaves exactly like Majestic.
# Exactly one process owns port 80, and exactly one owns the media hardware.
set -u

# STREAMERCTL_ROOT lets the host tests run the real logic against a throwaway
# tree. Empty in production, so every path below is absolute as usual.
ROOT="${STREAMERCTL_ROOT:-}"

STATE_DIR="$ROOT/etc/machino"
SELECTED="$STATE_DIR/streamer"              # majestic | machino
MACHINO_CONF="$STATE_DIR/machino.conf"

INIT_MAJESTIC="$ROOT/etc/init.d/majestic"   # moved here by install.sh so rcS no longer auto-starts it
INIT_MACHINO="$ROOT/etc/init.d/machino"
WWW_ROOT="$ROOT/var/www"
HTTPD="${STREAMERCTL_HTTPD:-/usr/sbin/httpd}"
HTTPD_PID="$ROOT/var/run/machino-httpd.pid"
HTTPD_CONF="$STATE_DIR/httpd.conf"          # basic auth + address rules for our WebUI host
# Front-door: Machino owns the PUBLIC port 80 (it serves the Majestic routes and
# relays everything else here); busybox httpd serves the stock OpenIPC WebUI
# privately on 127.0.0.1:85, not reachable from the LAN directly.
WEBUI_ADDR="127.0.0.1"
WEBUI_PORT="${STREAMERCTL_WEBUI_PORT:-85}"
# The PUBLIC front-door port Machino binds when it is the active owner. This
# MUST match what init/machino starts it with (--api-port), and it is what the
# health check and status probe - NOT api.port from machino.conf, which is only
# the stand-alone default and stays 8080 on upgraded cameras.
FRONT_PORT="${MACHINO_API_PORT:-80}"

HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-20}"      # seconds to wait for the new owner to come up

log()  { echo "$*"; }
warn() { echo "streamerctl: $*" >&2; }
die()  { echo "streamerctl: $*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers ---
api_port() {
    # api.port from the Machino config; 8080 is the documented default
    p=""
    [ -r "$MACHINO_CONF" ] && p=$(sed -n 's/^[[:space:]]*api\.port[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$MACHINO_CONF" | tail -1)
    [ -n "$p" ] || p=8080
    echo "$p"
}

# Compatibility note - the single source of truth for "is Machino running":
# On the BusyBox pgrep shipped by this OpenIPC/T40NN image, `pgrep -x` does not
# reliably identify Machino by the expected short process name. Hardware
# verification showed the daemon running and serving API/RTSP while
# `pgrep -x machino` returned no match (its argv0 is the full path
# /usr/bin/machino). Matching the executable path in the command line
# (`pgrep -f /usr/bin/machino`) is the verified behaviour on this target.
# Keep this in ONE helper; no bare pgrep for machino anywhere else. If a future
# BusyBox makes exact-name matching reliable, change it here after hardware
# verification. Majestic is matched separately by -x on purpose: its init starts
# it with argv0="majestic" (start-stop-daemon -a), which -x matches correctly.
MACHINO_BIN="${STREAMERCTL_MACHINO_BIN:-/usr/bin/machino}"
majestic_running() { pgrep -x majestic >/dev/null 2>&1; }
machino_running()  { pgrep -f "$MACHINO_BIN" >/dev/null 2>&1; }
owner_running() { case "$1" in machino) machino_running ;; majestic) majestic_running ;; *) return 1 ;; esac; }

# kill -0 rather than /proc: it is the portable liveness test and does not
# assume /proc is mounted.
alive() { kill -0 "$1" 2>/dev/null; }

our_httpd_pid() {
    [ -r "$HTTPD_PID" ] || return 1
    pid=$(cat "$HTTPD_PID" 2>/dev/null)
    [ -n "$pid" ] && alive "$pid" || return 1
    echo "$pid"
}

# Who owns the PUBLIC port 80. Majestic serves it directly; Machino is the
# front door when it runs; busybox httpd is internal (:85) and never public.
port80_owner() {
    if majestic_running; then echo majestic
    elif machino_running; then echo machino
    else echo none
    fi
}

# Wait until an owner is really gone. A half-stopped media owner is exactly the
# state that must never overlap with the next one.
wait_gone() {
    _name=$1; _limit=${2:-15}; _i=0
    while owner_running "$_name"; do
        _i=$((_i + 1))
        [ "$_i" -ge "$_limit" ] && return 1
        sleep 1
    done
    return 0
}

read_selection() {
    if [ -r "$SELECTED" ]; then cat "$SELECTED"; else echo majestic; fi
}

write_selection() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$SELECTED.tmp" && mv "$SELECTED.tmp" "$SELECTED"
}

# ------------------------------------------------------------ webui host ---
# The WebUI host. By default it serves the OpenIPC WebUI the way the camera
# normally does while Majestic runs: reachable on the LAN, no extra wall. An
# OPTIONAL Basic-auth password (streamerctl webui-password <pw>) puts a lock on
# the whole WebUI for those who want it; without one we do NOT put a
# second, separate login in front of the whole WebUI (that only produced an
# endless Basic-auth prompt with a password nobody set). Clear it with
# `streamerctl webui-password --clear`.
write_httpd_conf() {
    mkdir -p "$STATE_DIR"
    if [ -s "$STATE_DIR/webui.passwd" ]; then
        { echo "# generated by streamerctl - do not edit, use: streamerctl webui-password"
          echo "/:$(cat "$STATE_DIR/webui.passwd")"
        } > "$HTTPD_CONF"
    else
        { echo "# generated by streamerctl - no WebUI password set: the WebUI is"
          echo "# served openly on the LAN, like the stock OpenIPC WebUI. Lock it"
          echo "# with: streamerctl webui-password <password>"
          echo "A:*"
        } > "$HTTPD_CONF"
    fi
    chmod 0600 "$HTTPD_CONF"
}

cmd_webui_password() {
    [ -n "${1:-}" ] || die "usage: streamerctl webui-password <password>|--clear"
    case "$1" in
        --clear|clear|off|none|"")
            rm -f "$STATE_DIR/webui.passwd"
            write_httpd_conf
            log "WebUI password cleared - the WebUI is served openly on the LAN."
            if our_httpd_pid >/dev/null 2>&1; then webui_stop && webui_start; fi
            return 0 ;;
    esac
    mkdir -p "$STATE_DIR"
    hash=$("$HTTPD" -m "$1" 2>/dev/null)
    [ -n "$hash" ] || die "could not hash the password ($HTTPD -m failed)"
    printf 'root:%s
' "$hash" > "$STATE_DIR/webui.passwd"
    chmod 0600 "$STATE_DIR/webui.passwd"
    write_httpd_conf
    log "WebUI password set (user 'root'). It applies the next time Machino is activated."
    if our_httpd_pid >/dev/null 2>&1; then
        log "restarting the WebUI host so it takes effect now"
        webui_stop && webui_start
    fi
}

webui_start() {
    [ -x "$HTTPD" ] || { warn "no $HTTPD - WebUI will not be served while Machino is active"; return 0; }
    # Restart an existing instance instead of leaving it: after an upgrade the
    # running httpd still holds the OLD config/auth (this was the login-loop that
    # survived a re-install until reboot). Stop it, then start with the current
    # conf below.
    if our_httpd_pid >/dev/null 2>&1; then webui_stop; fi
    # Prefer the stock OpenIPC WebUI auth so the SAME login as the normal WebUI
    # applies (Machino relays through to it, no second login). Only when the
    # image ships none do we generate our own conf (open by default, optional
    # password lock). This httpd is the INTERNAL backend on 127.0.0.1:$WEBUI_PORT;
    # Machino is the public server on :80.
    if [ -f "$ROOT/etc/httpd.conf" ]; then
        CONF="$ROOT/etc/httpd.conf"
        log "serving the internal WebUI backend with the stock OpenIPC auth ($CONF)"
    else
        write_httpd_conf
        CONF="$HTTPD_CONF"
        [ -s "$STATE_DIR/webui.passwd" ] || warn "no WebUI password set - the WebUI is open on the LAN (lock it: streamerctl webui-password <password>)"
    fi
    "$HTTPD" -p "$WEBUI_ADDR:$WEBUI_PORT" -h "$WWW_ROOT" -c "$CONF" -r "OpenIPC" || { warn "httpd failed to start on $WEBUI_ADDR:$WEBUI_PORT"; return 1; }
    sleep 1
    pid=$(pgrep -f "httpd -p $WEBUI_ADDR:$WEBUI_PORT -h $WWW_ROOT" | head -1)
    [ -n "$pid" ] || { warn "internal WebUI backend did not come up on $WEBUI_ADDR:$WEBUI_PORT"; return 1; }
    mkdir -p "$(dirname "$HTTPD_PID")"
    printf '%s\n' "$pid" > "$HTTPD_PID"
    return 0
}

webui_stop() {
    pid=$(our_httpd_pid 2>/dev/null) || { rm -f "$HTTPD_PID"; return 0; }
    kill "$pid" 2>/dev/null
    _i=0
    while alive "$pid" && [ "$_i" -lt 10 ]; do _i=$((_i + 1)); sleep 1; done
    rm -f "$HTTPD_PID"
    alive "$pid" && { warn "httpd $pid would not stop"; return 1; }
    return 0
}

# ----------------------------------------------------------- healthchecks ---
# Machino is healthy as soon as its API answers. COLD_IDLE is a healthy state:
# "no consumer, no pipeline" means an idle camera has no pipeline by design.
machino_healthy() {
    port="$FRONT_PORT"; _i=0
    while [ "$_i" -lt "$HEALTH_TIMEOUT" ]; do
        machino_running || { _i=$((_i + 1)); sleep 1; continue; }
        if wget -q -O /dev/null -T 2 "http://127.0.0.1:$port/api/v1/state" 2>/dev/null; then return 0; fi
        _i=$((_i + 1)); sleep 1
    done
    machino_running && warn "machino runs but its API on port $port did not answer"
    return 1
}

# A live process is not enough: this T40NN has shown majestic running with its
# web server up while its media SDK failed ("Cannot start SDK"). Port 80 is the
# part we can check from here and the part the operator needs to switch back
# with. Whether video actually flows is a property of the majestic build, not
# something this script can fix - it is reported, not asserted.
majestic_healthy() {
    _i=0
    while [ "$_i" -lt "$HEALTH_TIMEOUT" ]; do
        if majestic_running && wget -q -O /dev/null -T 2 "http://127.0.0.1/index.html" 2>/dev/null; then
            return 0
        fi
        _i=$((_i + 1)); sleep 1
    done
    if majestic_running; then
        warn "majestic runs but does not serve port 80 - the WebUI is unreachable"
        return 1
    fi
    return 1
}

# Note on the hardware watchdog: an earlier version kept a busybox watchdog
# feeder alive across the switch, on the theory that stopping majestic left the
# watchdog armed. Hardware tests disproved that - majestic releases
# /dev/watchdog when it stops, so switching to machino needs no feeder and
# produced no reset without one. The feeder was removed rather than carried
# along on a disproven cause. (The reset seen on the RETURN path is majestic's
# own media/SDK failure on this T40NN, unrelated to the watchdog.)

# --------------------------------------------------------------- switching ---
stop_all_owners() {
    if machino_running; then
        [ -x "$INIT_MACHINO" ] && "$INIT_MACHINO" stop >/dev/null 2>&1
        wait_gone machino || { warn "machino would not stop"; return 1; }
    fi
    if majestic_running; then
        [ -x "$INIT_MAJESTIC" ] && "$INIT_MAJESTIC" stop >/dev/null 2>&1
        wait_gone majestic || { warn "majestic would not stop"; return 1; }
    fi
    return 0
}

activate_machino() {
    stop_all_owners || return 1
    webui_start || warn "WebUI is not being served - use the CLI to switch back"
    [ -x "$INIT_MACHINO" ] || { warn "$INIT_MACHINO missing"; return 1; }
    # Front-door contract: init/machino must bind FRONT_PORT and relay to the
    # internal busybox on WEBUI_PORT. Pass both so the two never disagree.
    MACHINO_API_PORT="$FRONT_PORT" MACHINO_UPSTREAM_PORT="$WEBUI_PORT" "$INIT_MACHINO" start >/dev/null 2>&1
    machino_healthy
}

activate_majestic() {
    stop_all_owners || return 1
    webui_stop || return 1                 # hand port 80 back before majestic claims it
    [ -x "$INIT_MAJESTIC" ] || { warn "$INIT_MAJESTIC missing"; return 1; }
    "$INIT_MAJESTIC" start >/dev/null 2>&1
    majestic_healthy
}

activate() {
    case "$1" in
        machino)  activate_machino ;;
        majestic) activate_majestic ;;
        none)     stop_all_owners && webui_stop ;;
        *)        warn "unknown streamer '$1'"; return 1 ;;
    esac
}

# Set the boot selection ONLY - no media owner is started or stopped. This is
# the safe way back on hardware where a live switch cannot succeed (e.g. a
# T40NN whose majestic media stack resets the board on start): pick the owner,
# then reboot, and S95streamer brings it up on a fresh ISP. Unlike "set", this
# always persists, because it never depends on a live start that might fail and
# roll the selection back.
cmd_select() {
    want=$1
    case "$want" in machino|majestic|none) ;; *) die "usage: streamerctl select {machino|majestic|none}" ;; esac
    write_selection "$want"
    log "boot selection set to '$want' (nothing started or stopped; applies at next boot)"
    cmd_status
}

cmd_set() {
    want=$1
    case "$want" in machino|majestic|none) ;; *) die "usage: streamerctl set {machino|majestic|none}" ;; esac
    previous=$(read_selection)
    log "switching: $previous -> $want"
    if activate "$want"; then
        write_selection "$want"
        log "active streamer: $want"
        cmd_status
        return 0
    fi
    warn "$want did not come up - rolling back to $previous"
    if [ "$want" != "$previous" ] && activate "$previous"; then
        write_selection "$previous"
        warn "rolled back to $previous"
    else
        warn "rollback to $previous FAILED - camera has no active streamer"
        warn "recover with: streamerctl set majestic  (or: streamerctl select majestic && reboot - see docs/install-openipc.md)"
    fi
    cmd_status
    return 1
}

cmd_status() {
    sel=$(read_selection)
    run=none
    machino_running  && run=machino
    majestic_running && run=majestic
    echo "selected:     $sel"
    echo "running:      $run"
    echo "port 80:      $(port80_owner)"
    if machino_running; then
        port="$FRONT_PORT"
        st=$(wget -q -O- -T 2 "http://127.0.0.1:$port/api/v1/state" 2>/dev/null |
             sed -n 's/.*"lifecycle"[[:space:]]*:[[:space:]]*"\([a-z_]*\)".*/\1/p')
        echo "machino api:  ${st:-no answer} (port $port)"
    fi
    [ "$sel" = "$run" ] || echo "note:         selection and running process differ"
    if [ "$run" = machino ] && [ "$(port80_owner)" = none ]; then
        echo "warning:      nothing serves port 80 - the WebUI is unreachable"
    fi
}

cmd_boot() {
    # called by /etc/init.d/S95streamer at boot: bring up exactly the selection
    sel=$(read_selection)
    log "streamerctl: boot selection '$sel'"
    activate "$sel" && return 0
    warn "boot: '$sel' did not come up"
    [ "$sel" = machino ] || return 1
    # Fall back so the camera is not left without a media owner. The stored
    # selection is deliberately NOT rewritten: the next boot tries the wanted
    # one again, and "streamerctl status" keeps showing that the two disagree
    # instead of quietly pretending majestic was the choice all along.
    warn "boot: falling back to majestic (the selection stays '$sel')"
    if activate majestic; then return 0; fi
    warn "boot: majestic did not come up either - no media owner"
    return 1
}

usage() {
    cat <<EOF
usage: streamerctl <command>

  status              show selected/running streamer and who serves port 80
  set machino         stop majestic, serve the WebUI, start machino (rolls back on failure)
  set majestic        stop machino, hand port 80 back, start majestic (rolls back on failure)
  set none            stop every media owner (WebUI stays on whatever serves it)
  select machino|majestic|none   set the boot selection only; start/stop nothing
                                 (the safe way back where a live switch cannot succeed)
  boot                apply the stored selection (used by /etc/init.d/S95streamer)
  webui-password P    set an optional password for the WebUI while Machino is active

The selection is stored in $SELECTED and survives a reboot.
EOF
}

case "${1:-}" in
    status)  cmd_status ;;
    webui-password) cmd_webui_password "${2:-}" ;;
    set)     [ $# -ge 2 ] || die "usage: streamerctl set {machino|majestic|none}"; cmd_set "$2" ;;
    select)  [ $# -ge 2 ] || die "usage: streamerctl select {machino|majestic|none}"; cmd_select "$2" ;;
    boot)    cmd_boot ;;
    ""|-h|--help|help) usage ;;
    *)       die "unknown command '$1' (try: streamerctl help)" ;;
esac
