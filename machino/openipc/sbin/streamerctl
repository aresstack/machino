#!/bin/sh
# streamerctl - select the media owner on an OpenIPC camera.
#
# Machino and Majestic may both be installed, but never both own the media
# hardware: on a T40NN a second owner has been observed to reset the board.
# This script is the single place that switches between them, and it is
# deliberately NOT part of the Machino daemon: when Majestic is active and
# Machino is stopped, a Machino web API could not be reached to switch back.
#
# Majestic also serves the OpenIPC WebUI on port 80 (system.webPort, staticDir
# /var/www). Stopping it therefore takes the WebUI down with it - including the
# page you would use to switch back. So while Machino is the selected owner we
# run busybox httpd on port 80 over the same /var/www, and hand port 80 back to
# Majestic when it is selected again. Exactly one process serves port 80, and
# exactly one process owns the media hardware, at any time.
set -u

# STREAMERCTL_ROOT lets the host tests run the real logic against a throwaway
# tree. Empty in production, so every path below is absolute as usual.
ROOT="${STREAMERCTL_ROOT:-}"

STATE_DIR="$ROOT/etc/machino"
SELECTED="$STATE_DIR/streamer"              # majestic | machino
MACHINO_CONF="$STATE_DIR/machino.conf"

INIT_MAJESTIC="$ROOT/etc/init.d/majestic"   # moved here by install.sh so rcS no longer auto-starts it
INIT_MACHINO="$ROOT/etc/init.d/machino"
WWW_ROOT="$ROOT/var/www"
HTTPD="${STREAMERCTL_HTTPD:-/usr/sbin/httpd}"
HTTPD_PID="$ROOT/var/run/machino-httpd.pid"
HTTPD_CONF="$STATE_DIR/httpd.conf"          # basic auth + address rules for our WebUI host
WDT="${STREAMERCTL_WDT:-/dev/watchdog}"
WDT_FEEDER="${STREAMERCTL_WDT_FEEDER:-watchdog}"   # busybox applet
WDT_PID="$ROOT/var/run/machino-wdt.pid"

HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-20}"      # seconds to wait for the new owner to come up

log()  { echo "$*"; }
warn() { echo "streamerctl: $*" >&2; }
die()  { echo "streamerctl: $*" >&2; exit 1; }

# ---------------------------------------------------------------- helpers ---
api_port() {
    # api.port from the Machino config; 8080 is the documented default
    p=""
    [ -r "$MACHINO_CONF" ] && p=$(sed -n 's/^[[:space:]]*api\.port[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$MACHINO_CONF" | tail -1)
    [ -n "$p" ] || p=8080
    echo "$p"
}

# machino's argv0 is its full path, so it must be matched by path (pgrep -f);
# pgrep -x machino never matches it on this busybox. majestic is started by its
# init with argv0="majestic" (start-stop-daemon -a), so -x is right for it.
MACHINO_BIN="${STREAMERCTL_MACHINO_BIN:-/usr/bin/machino}"
majestic_running() { pgrep -x majestic >/dev/null 2>&1; }
machino_running()  { pgrep -f "$MACHINO_BIN" >/dev/null 2>&1; }
owner_running() { case "$1" in machino) machino_running ;; majestic) majestic_running ;; *) return 1 ;; esac; }

# kill -0 rather than /proc: it is the portable liveness test and does not
# assume /proc is mounted.
alive() { kill -0 "$1" 2>/dev/null; }

our_httpd_pid() {
    [ -r "$HTTPD_PID" ] || return 1
    pid=$(cat "$HTTPD_PID" 2>/dev/null)
    [ -n "$pid" ] && alive "$pid" || return 1
    echo "$pid"
}

port80_owner() {
    if majestic_running; then echo majestic
    elif our_httpd_pid >/dev/null 2>&1; then echo httpd
    else echo none
    fi
}

# Wait until an owner is really gone. A half-stopped media owner is exactly the
# state that must never overlap with the next one.
wait_gone() {
    _name=$1; _limit=${2:-15}; _i=0
    while owner_running "$_name"; do
        _i=$((_i + 1))
        [ "$_i" -ge "$_limit" ] && return 1
        sleep 1
    done
    return 0
}

read_selection() {
    if [ -r "$SELECTED" ]; then cat "$SELECTED"; else echo majestic; fi
}

write_selection() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$SELECTED.tmp" && mv "$SELECTED.tmp" "$SELECTED"
}

# ------------------------------------------------------------ webui host ---
# Majestic's WebUI has a login; our replacement host must not silently drop it.
# machino.cgi runs streamerctl as root, so an unauthenticated one would let
# anyone on the network take the camera's media hardware. Without a password
# the config falls back to loopback-only, which is useless from a browser but
# cannot be abused - fail closed, then say so.
write_httpd_conf() {
    mkdir -p "$STATE_DIR"
    if [ -s "$STATE_DIR/webui.passwd" ]; then
        { echo "# generated by streamerctl - do not edit, use: streamerctl webui-password"
          echo "/cgi-bin:$(cat "$STATE_DIR/webui.passwd")"
        } > "$HTTPD_CONF"
    else
        { echo "# generated by streamerctl - no WebUI password set, so the CGI is"
          echo "# restricted to the camera itself. Set one with:"
          echo "#   streamerctl webui-password <password>"
          echo "A:127.0.0.1"
          echo "D:*"
        } > "$HTTPD_CONF"
    fi
    chmod 0600 "$HTTPD_CONF"
}

cmd_webui_password() {
    [ -n "${1:-}" ] || die "usage: streamerctl webui-password <password>"
    mkdir -p "$STATE_DIR"
    hash=$("$HTTPD" -m "$1" 2>/dev/null)
    [ -n "$hash" ] || die "could not hash the password ($HTTPD -m failed)"
    printf 'root:%s
' "$hash" > "$STATE_DIR/webui.passwd"
    chmod 0600 "$STATE_DIR/webui.passwd"
    write_httpd_conf
    log "WebUI password set (user 'root'). It applies the next time Machino is activated."
    if our_httpd_pid >/dev/null 2>&1; then
        log "restarting the WebUI host so it takes effect now"
        webui_stop && webui_start
    fi
}

webui_start() {
    [ -x "$HTTPD" ] || { warn "no $HTTPD - WebUI will not be served while Machino is active"; return 0; }
    if our_httpd_pid >/dev/null 2>&1; then return 0; fi
    if majestic_running; then warn "majestic still holds port 80 - not starting a second server"; return 1; fi
    write_httpd_conf
    [ -s "$STATE_DIR/webui.passwd" ] || warn "no WebUI password set - the switch page is reachable from the camera only (streamerctl webui-password <password>)"
    "$HTTPD" -p 80 -h "$WWW_ROOT" -c "$HTTPD_CONF" -r "Machino" || { warn "httpd failed to start on port 80"; return 1; }
    sleep 1
    pid=$(pgrep -f "httpd -p 80 -h $WWW_ROOT" | head -1)
    [ -n "$pid" ] || { warn "httpd did not come up"; return 1; }
    mkdir -p "$(dirname "$HTTPD_PID")"
    printf '%s\n' "$pid" > "$HTTPD_PID"
    return 0
}

webui_stop() {
    pid=$(our_httpd_pid 2>/dev/null) || { rm -f "$HTTPD_PID"; return 0; }
    kill "$pid" 2>/dev/null
    _i=0
    while alive "$pid" && [ "$_i" -lt 10 ]; do _i=$((_i + 1)); sleep 1; done
    rm -f "$HTTPD_PID"
    alive "$pid" && { warn "httpd $pid would not stop"; return 1; }
    return 0
}

# ----------------------------------------------------------- healthchecks ---
# Machino is healthy as soon as its API answers. COLD_IDLE is a healthy state:
# "no consumer, no pipeline" means an idle camera has no pipeline by design.
machino_healthy() {
    port=$(api_port); _i=0
    while [ "$_i" -lt "$HEALTH_TIMEOUT" ]; do
        machino_running || { _i=$((_i + 1)); sleep 1; continue; }
        if wget -q -O /dev/null -T 2 "http://127.0.0.1:$port/api/v1/state" 2>/dev/null; then return 0; fi
        _i=$((_i + 1)); sleep 1
    done
    machino_running && warn "machino runs but its API on port $port did not answer"
    return 1
}

# A live process is not enough: this T40NN has shown majestic running with its
# web server up while its media SDK failed ("Cannot start SDK"). Port 80 is the
# part we can check from here and the part the operator needs to switch back
# with. Whether video actually flows is a property of the majestic build, not
# something this script can fix - it is reported, not asserted.
majestic_healthy() {
    _i=0
    while [ "$_i" -lt "$HEALTH_TIMEOUT" ]; do
        if majestic_running && wget -q -O /dev/null -T 2 "http://127.0.0.1/index.html" 2>/dev/null; then
            return 0
        fi
        _i=$((_i + 1)); sleep 1
    done
    if majestic_running; then
        warn "majestic runs but does not serve port 80 - the WebUI is unreachable"
        return 1
    fi
    return 1
}

# Majestic arms the hardware watchdog (majestic.yaml watchdog.enabled, 15 s)
# and holds /dev/watchdog open. Killing it leaves the watchdog armed with no
# feeder, and 15 seconds later the SoC resets without a single line of console
# output - that is how the first real switch on the T40NN died. So whenever
# majestic is not the one running, this script keeps a busybox watchdog feeder
# alive, and stops it right before majestic starts, because the device allows
# only one opener.
wdt_feeder_start() {
    if [ -r "$WDT_PID" ]; then
        _p=$(cat "$WDT_PID" 2>/dev/null)
        [ -n "$_p" ] && alive "$_p" && return 0
    fi
    case "$WDT_FEEDER" in
        /*) [ -x "$WDT_FEEDER" ] || { warn "no watchdog feeder at $WDT_FEEDER - a majestic-armed watchdog will reset the board"; return 1; } ;;
        *)  command -v "$WDT_FEEDER" >/dev/null 2>&1 || { warn "no watchdog feeder available - a majestic-armed watchdog will reset the board"; return 1; } ;;
    esac
    "$WDT_FEEDER" -t 4 -T 60 "$WDT" || { warn "could not start the watchdog feeder"; return 1; }
    sleep 1
    _p=$(pgrep -f "$WDT_FEEDER -t 4" | head -1)
    [ -n "$_p" ] || { warn "watchdog feeder did not come up"; return 1; }
    mkdir -p "$(dirname "$WDT_PID")"
    printf '%s
' "$_p" > "$WDT_PID"
    return 0
}

wdt_feeder_stop() {
    [ -r "$WDT_PID" ] || return 0
    _p=$(cat "$WDT_PID" 2>/dev/null)
    rm -f "$WDT_PID"
    [ -n "$_p" ] || return 0
    kill "$_p" 2>/dev/null              # busybox watchdog disarms on SIGTERM (magic close)
    _i=0
    while alive "$_p" && [ "$_i" -lt 5 ]; do _i=$((_i + 1)); sleep 1; done
    return 0
}

# --------------------------------------------------------------- switching ---
stop_all_owners() {
    if machino_running; then
        [ -x "$INIT_MACHINO" ] && "$INIT_MACHINO" stop >/dev/null 2>&1
        wait_gone machino || { warn "machino would not stop"; return 1; }
    fi
    if majestic_running; then
        [ -x "$INIT_MAJESTIC" ] && "$INIT_MAJESTIC" stop >/dev/null 2>&1
        wait_gone majestic || { warn "majestic would not stop"; return 1; }
    fi
    return 0
}

activate_machino() {
    stop_all_owners || return 1
    wdt_feeder_start                     # majestic may have left the watchdog armed
    webui_start || warn "WebUI is not being served - use the CLI to switch back"
    [ -x "$INIT_MACHINO" ] || { warn "$INIT_MACHINO missing"; return 1; }
    "$INIT_MACHINO" start >/dev/null 2>&1
    machino_healthy
}

activate_majestic() {
    stop_all_owners || return 1
    wdt_feeder_stop                        # single-opener device: majestic takes it back
    webui_stop || return 1                 # hand port 80 back before majestic claims it
    [ -x "$INIT_MAJESTIC" ] || { warn "$INIT_MAJESTIC missing"; return 1; }
    "$INIT_MAJESTIC" start >/dev/null 2>&1
    majestic_healthy
}

activate() {
    case "$1" in
        machino)  activate_machino ;;
        majestic) activate_majestic ;;
        none)     stop_all_owners && wdt_feeder_start && webui_stop ;;
        *)        warn "unknown streamer '$1'"; return 1 ;;
    esac
}

cmd_set() {
    want=$1
    case "$want" in machino|majestic|none) ;; *) die "usage: streamerctl set {machino|majestic|none}" ;; esac
    previous=$(read_selection)
    log "switching: $previous -> $want"
    if activate "$want"; then
        write_selection "$want"
        log "active streamer: $want"
        cmd_status
        return 0
    fi
    warn "$want did not come up - rolling back to $previous"
    if [ "$want" != "$previous" ] && activate "$previous"; then
        write_selection "$previous"
        warn "rolled back to $previous"
    else
        warn "rollback to $previous FAILED - camera has no active streamer"
        warn "recover with: streamerctl set majestic   (see docs/install-openipc.md)"
    fi
    cmd_status
    return 1
}

cmd_status() {
    sel=$(read_selection)
    run=none
    machino_running  && run=machino
    majestic_running && run=majestic
    echo "selected:     $sel"
    echo "running:      $run"
    echo "port 80:      $(port80_owner)"
    if [ -r "$WDT_PID" ] && _wp=$(cat "$WDT_PID" 2>/dev/null) && [ -n "$_wp" ] && alive "$_wp"; then
        echo "watchdog:     fed by streamerctl (pid $_wp)"
    fi
    if machino_running; then
        port=$(api_port)
        st=$(wget -q -O- -T 2 "http://127.0.0.1:$port/api/v1/state" 2>/dev/null |
             sed -n 's/.*"lifecycle"[[:space:]]*:[[:space:]]*"\([a-z_]*\)".*/\1/p')
        echo "machino api:  ${st:-no answer} (port $port)"
    fi
    [ "$sel" = "$run" ] || echo "note:         selection and running process differ"
    if [ "$run" = machino ] && [ "$(port80_owner)" = none ]; then
        echo "warning:      nothing serves port 80 - the WebUI is unreachable"
    fi
}

cmd_boot() {
    # called by /etc/init.d/S95streamer at boot: bring up exactly the selection
    sel=$(read_selection)
    log "streamerctl: boot selection '$sel'"
    activate "$sel" && return 0
    warn "boot: '$sel' did not come up"
    [ "$sel" = machino ] || return 1
    # Fall back so the camera is not left without a media owner. The stored
    # selection is deliberately NOT rewritten: the next boot tries the wanted
    # one again, and "streamerctl status" keeps showing that the two disagree
    # instead of quietly pretending majestic was the choice all along.
    warn "boot: falling back to majestic (the selection stays '$sel')"
    activate majestic || warn "boot: majestic did not come up either - no media owner"
}

usage() {
    cat <<EOF
usage: streamerctl <command>

  status              show selected/running streamer and who serves port 80
  set machino         stop majestic, serve the WebUI, start machino (rolls back on failure)
  set majestic        stop machino, hand port 80 back, start majestic (rolls back on failure)
  set none            stop every media owner (WebUI stays on whatever serves it)
  boot                apply the stored selection (used by /etc/init.d/S95streamer)
  webui-password P    set the password for the switch page while Machino is active

The selection is stored in $SELECTED and survives a reboot.
EOF
}

case "${1:-}" in
    status)  cmd_status ;;
    webui-password) cmd_webui_password "${2:-}" ;;
    set)     [ $# -ge 2 ] || die "usage: streamerctl set {machino|majestic|none}"; cmd_set "$2" ;;
    boot)    cmd_boot ;;
    ""|-h|--help|help) usage ;;
    *)       die "unknown command '$1' (try: streamerctl help)" ;;
esac
