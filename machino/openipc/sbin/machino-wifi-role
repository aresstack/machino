#!/bin/sh
# Wer besitzt wlan0: der Supplicant oder hostapd.
#
# WARUM ES DAS GIBT
#
# Auf diesem Radio sind Station und Access Point GEGENSEITIGE Rollen --
# driver_concurrent_sta_ap ist false, und das ist keine Vorsicht, sondern der
# Stand des Wissens. Zwei Daemons gleichzeitig auf wlan0 loszulassen erzeugt
# einen Access Point, der hochkommt und Sekunden spaeter wieder wegbricht,
# weil der Supplicant weiterscannt.
#
# Und machino darf beide nicht selbst starten: fork+exec bei laufender
# IMP-Pipeline ist der dokumentierte OOM-Ausloeser dieser Kamera.
#
# Also besitzt DIESER Prozess das Interface. Er wird einmal beim Boot
# gestartet -- vor machinod, also bevor IMP existiert -- und liest danach nur
# noch eine Datei. machino schreibt die Absicht hinein.
#
# Hier wird durchaus geforkt: ein Rollenwechsel startet Prozesse, das ist seine
# Aufgabe. Der Punkt der Trennung ist ein anderer und praeziser: der Prozess
# mit der grossen IMP-Pipeline forkt nicht. Dieser kleine Supervisor hat ein
# paar hundert Kilobyte RSS, und ein fork() aus ihm heraus ist harmlos, waehrend
# dasselbe aus machino heraus die Box umbringt.
#
# Zweiter Zweck: es gibt genau EINEN Besitzer von wlan0. Zwei Daemons darauf
# ergeben einen Access Point, der hochkommt und Sekunden spaeter wegbricht.
#
#   /etc/machino/wifi-role      station | ap | off
#
# Der Rollenwechsel startet hostapd FRISCH statt es neu zu konfigurieren. Das
# ist der Unterschied, an dem die erste Fassung gescheitert waere: hostapds
# ENABLE bringt die Konfiguration hoch, die es bereits im Speicher hat, und
# liest die Datei nicht neu -- ein frischer Start tut es immer.

ROLE_FILE=/etc/machino/wifi-role
IFACE=wlan0
WPACONF=/etc/machino/wpa-supplicant.conf
APCONF=/etc/machino/hostapd.conf
DHCPDCONF=/etc/machino/udhcpd.conf
DHCPSCRIPT=/etc/machino/udhcpc-wlan.script
WPACTRL=/var/run/wpa_supplicant
APCTRL=/var/run/hostapd
WPAPID=/var/run/wpa_supplicant.wlan0.pid
APPID=/var/run/hostapd.pid
DHCPCPID=/var/run/udhcpc.wlan0.pid
# Nicht auf das Overlay: das hier ist Diagnose, kein Zustand, und Flash-Schreiben
# fuer Logzeilen ist auf einer Kamera mit 4,3 MB frei die falsche Entscheidung.
LOGFILE=/tmp/machino-wifi-role.log
# Zwischenpuffer fuer die Daemon-Ausgabe, bevor sie gefiltert ins Log geht.
OUTTMP=/tmp/.machino-wifi-role.out
POLL=2

# Auch in die Datei. S42wifi startet den Supervisor mit >/dev/null, und bei
# der ersten Fehlschaltung auf Hardware war genau das das Problem: es stand
# "wpa_supplicant startete nicht" da, und der Grund war nirgends.
log() { echo "wifi-role: $*"; echo "$(date '+%H:%M:%S') wifi-role: $*" >> "$LOGFILE" 2>/dev/null; }

# Nur die EIGENEN Prozesse beenden, nie per killall. Eine spaetere Kamera kann
# einen zweiten Supplicant auf einer anderen Schnittstelle fahren -- ein
# pauschales "killall wpa_supplicant" wuerde den mit abraeumen, und das faellt
# dann an einer ganz anderen Stelle auf.
#
# Und danach WARTEN, bis der Prozess wirklich weg ist. Die erste Fassung hat
# nur SIGTERM geschickt und ist sofort weitergelaufen -- der Rollenwechsel
# AP -> Station ist auf echter Hardware genau daran gescheitert (siehe
# docs/aic8800-bringup.md). kill(1) kehrt zurueck, wenn das Signal zugestellt
# ist, nicht wenn der Empfaenger fertig ist.
kill_pidfile() {
	[ -f "$1" ] || return 0
	pid=$(cat "$1" 2>/dev/null)
	rm -f "$1"
	[ -n "$pid" ] || return 0
	kill "$pid" 2>/dev/null || return 0
	n=0
	while kill -0 "$pid" 2>/dev/null; do
		n=$((n + 1))
		if [ $n -ge 50 ]; then           # 5 s hoeflich, dann nicht mehr
			log "PID $pid reagiert nicht auf TERM - KILL"
			kill -9 "$pid" 2>/dev/null
			sleep 1
			break
		fi
		usleep 100000 2>/dev/null || sleep 1
	done
	return 0
}

# Beim Start: alles beenden, was UNSER Interface haelt.
#
# Die PID-Datei allein reicht dafuer nicht, und der Grund ist unangenehm
# genau: ein FEHLGESCHLAGENER wpa_supplicant-Start loescht beim Aufraeumen die
# PID-Datei -- dieselbe Datei, die der noch laufende Supplicant geschrieben
# hat. Danach zeigt kein Griff mehr auf ihn, und beim naechsten Start stehen
# zwei Supplicants auf wlan0. Auf der Kamera gesehen, nachdem zehn
# Startversuche gegen einen belegten ctrl-Socket gelaufen waren.
#
# Das ist ausdruecklich KEIN killall. Es muessen ZWEI Dinge zutreffen: der
# Programmname aus /proc/<pid>/comm ist einer unserer Daemons, UND die
# Kommandozeile nennt genau unser Interface (bzw. bei hostapd unsere
# Konfigurationsdatei, weil hostapd das Interface nicht als Argument fuehrt).
# Ein zweiter Supplicant auf einer anderen Schnittstelle -- der Fall, wegen dem
# killall hier verboten ist -- bleibt unberuehrt.
#
# Nur beim Start. Im laufenden Betrieb reichen die PID-Dateien, weil dann wir
# es sind, die sie geschrieben haben.
claim_interface() {
	for d in /proc/[0-9]*; do
		p=${d#/proc/}
		[ "$p" = "$$" ] && continue
		# Der PROGRAMMNAME entscheidet, nicht der Text der Kommandozeile. Sonst
		# trifft es jede Shell, in der zufaellig "wpa_supplicant" und "wlan0"
		# vorkommen -- etwa eine, die gerade danach sucht.
		pname=$(cat "$d/comm" 2>/dev/null) || continue
		case "$pname" in
			wpa_supplicant|hostapd|udhcpc|udhcpd) ;;
			*) continue ;;
		esac
		# Und das Interface muss wirklich unseres sein. Ein Supplicant auf einer
		# anderen Schnittstelle geht uns nichts an; hostapd nennt sein Interface
		# nicht auf der Kommandozeile, also gilt dort unsere Konfigurationsdatei
		# als Beleg.
		c=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null) || continue
		case "$c" in
			*" $IFACE "*|*" $IFACE") ;;
			*"$APCONF"*|*"$DHCPDCONF"*) ;;
			*) continue ;;
		esac
		log "fremder Halter von $IFACE: $pname (pid $p) -- wird beendet"
		kill "$p" 2>/dev/null
		n=0
		while kill -0 "$p" 2>/dev/null && [ $n -lt 30 ]; do
			n=$((n + 1)); usleep 100000 2>/dev/null || sleep 1
		done
		kill -9 "$p" 2>/dev/null
	done
	rm -f "$WPACTRL/$IFACE" "$APCTRL/$IFACE"
}

# Nach einem Rollenwechsel braucht der AIC8800 einen Moment. Im Kernel-Log
# steht der Grund wortwoertlich:
#
#     usb 1-1 wlan0: AP Stopped
#     change_if: 3 to 2, 8, 2
#
# Das ist ein Typwechsel des Interface im Treiber, und er passiert NACH dem
# Ende von hostapd. Wer sofort danach den Supplicant startet, trifft ein
# Interface, das gerade umgebaut wird. Deshalb wird der Start wiederholt
# statt einmalig versucht -- eine feste Wartezeit waere entweder zu kurz oder
# verschenkte Sekunden bei jedem Wechsel.
#
# Die Ausgabe geht NICHT direkt ins Log, sondern durch einen Filter.
#
# wpa_supplicant druckt die beanstandete Passphrase im Klartext, wenn es die
# Konfiguration nicht parsen kann. Auf dieser Kamera nachgemessen:
#
#     Line 4: Invalid passphrase length 4 (expected: 8..63) 'kurz"'.
#     Line 4: failed to parse psk '"kurz"'.
#
# machino prueft 8..63 Zeichen, bevor es schreibt, also trifft das den
# Normalfall nicht -- aber eine von Hand bearbeitete Datei, ein bei
# Stromausfall abgeschnittenes Schreiben oder eine spaetere Aenderung reichen.
# Ein Geheimnis darf nicht davon abhaengen, dass ein anderer Codepfad sauber
# bleibt.
#
# Der Wert wird ersetzt, nicht die Zeile geworfen: "Invalid passphrase length
# 4 (expected: 8..63)" ist genau die Diagnose, die man dann braucht.
redact() {
	sed -e "/[Pp][Ss][Kk]/s/'[^']*'/'<redigiert>'/g" \
	    -e "/[Pp]assphrase/s/'[^']*'/'<redigiert>'/g" \
	    -e "/[Pp]assword/s/'[^']*'/'<redigiert>'/g" "$1"
}

retry_start() {
	what=$1; shift
	n=0
	while [ $n -lt 10 ]; do
		"$@" > "$OUTTMP" 2>&1
		rc=$?
		redact "$OUTTMP" >> "$LOGFILE" 2>/dev/null
		: > "$OUTTMP"
		if [ $rc -eq 0 ]; then
			[ $n -gt 0 ] && log "$what kam im Versuch $((n + 1)) hoch"
			return 0
		fi
		n=$((n + 1))
		sleep 1
	done
	log "$what kam nach $n Versuchen nicht hoch - siehe $LOGFILE"
	return 1
}

stop_station() {
	kill_pidfile "$DHCPCPID"
	kill_pidfile "$WPAPID"
	# kill_pidfile hat bereits auf das Prozessende gewartet. Der Socket wird
	# beim Beenden aufgeraeumt; bleibt er als Leiche liegen, uebernimmt hostapd
	# ihn nicht, also weg damit.
	rm -f "$WPACTRL/$IFACE"
	# Die per DHCP bezogene Adresse muss weg. Bleibt sie stehen, traegt das
	# Interface in der AP-Rolle zwei Adressen -- die alte aus dem Hotspot-Netz
	# und die des Access Points -- und Clients bekommen Antworten von der
	# falschen.
	ip addr flush dev $IFACE 2>/dev/null
}

stop_ap() {
	kill_pidfile /var/run/udhcpd.pid
	kill_pidfile "$APPID"
	rm -f "$APCTRL/$IFACE"
	# Umgekehrt genauso: die AP-Adresse darf nicht in die Station-Rolle
	# hineinreichen.
	ip addr flush dev $IFACE 2>/dev/null
}

start_station() {
	[ -x /usr/sbin/wpa_supplicant ] || { log "kein wpa_supplicant im Image"; return 1; }
	mkdir -p "$WPACTRL"
	if [ ! -f "$WPACONF" ]; then
		umask 077
		printf 'ctrl_interface=%s\nupdate_config=1\n' "$WPACTRL" > "$WPACONF"
		chmod 600 "$WPACONF"
	fi
	ip link set $IFACE up
	retry_start "wpa_supplicant" \
		wpa_supplicant -B -P "$WPAPID" -i $IFACE -c "$WPACONF" -D nl80211 || return 1
	# DHCP als Daemon: nach einem Rollback assoziiert der Supplicant von
	# selbst neu, und ohne laufenden Client bliebe das Interface assoziiert
	# und adresslos.
	#
	# NICHT -b. Das hat den Supervisor auf der Kamera festgenagelt.
	#
	# BusyBox: "-b  Background if lease is not obtained" und "-t N  Send up to
	# N discover packets". Mit -t 0 (unbegrenzt) tritt "not obtained" nie ein,
	# also geht udhcpc nie in den Hintergrund und kehrt nie zurueck. Gemessen:
	#
	#     udhcpc  pid=13644 ppid=13632
	#     superv  pid=13632 wchan=do_wait
	#
	# Der Supervisor stand seit dem Start der Station-Rolle in do_wait und
	# konnte den Rollenwechsel nach AP nicht mehr sehen. Das ist genau der Weg,
	# den jemand braucht, dessen WLAN verschwunden ist: "schalt auf Access
	# Point, damit ich wieder drankomme" -- und der war tot.
	#
	# Also -f und selbst in den Hintergrund legen, wie bei udhcpd. Dann ist $!
	# exakt der Prozess, kill_pidfile trifft ihn, und die Schleife laeuft
	# weiter, waehrend udhcpc in Ruhe sucht.
	if command -v udhcpc >/dev/null 2>&1; then
		if [ -x "$DHCPSCRIPT" ]; then
			udhcpc -f -i $IFACE -t 0 -S -s "$DHCPSCRIPT" >/dev/null 2>&1 &
		else
			udhcpc -f -i $IFACE -t 0 -S >/dev/null 2>&1 &
		fi
		echo "$!" > "$DHCPCPID"
	fi
	log "Rolle station aktiv"
}

start_ap() {
	[ -x /usr/sbin/hostapd ] || { log "kein hostapd im Image"; return 1; }
	[ -f "$APCONF" ] || { log "keine $APCONF - machino schreibt sie beim Einschalten"; return 1; }
	mkdir -p "$APCTRL"
	ip link set $IFACE up
	retry_start "hostapd" hostapd -B -P "$APPID" "$APCONF" || return 1

	# Eigene Adresse und DHCP fuer die Clients. Ohne beides assoziieren
	# Telefone und bekommen nichts, was wie eine kaputte Kamera aussieht.
	ip_addr=$(sed -n 's/^option router *//p' "$DHCPDCONF" 2>/dev/null | head -1)
	[ -n "$ip_addr" ] && ip addr add "$ip_addr/24" dev $IFACE 2>/dev/null
	# udhcpd bekommt seine PID-Datei von UNS.
	#
	# BusyBox 1.36 kennt kein -P, und die Direktive "pidfile" in udhcpd.conf
	# wird von diesem Build stillschweigend nicht geschrieben -- auf der Kamera
	# nachgemessen: die Datei entstand nie. Folge in der ersten Fassung: der
	# DHCP-Server des Access Points ueberlebte den Wechsel nach Station und
	# verteilte weiter Adressen aus einem Netz, das es nicht mehr gab.
	#
	# Also -f (Vordergrund) und selbst in den Hintergrund legen. Dann ist $!
	# exakt der Prozess, und kill_pidfile trifft ihn.
	if [ -f "$DHCPDCONF" ] && command -v udhcpd >/dev/null 2>&1; then
		[ -f /var/run/udhcpd.leases ] || : > /var/run/udhcpd.leases
		udhcpd -f "$DHCPDCONF" >>"$LOGFILE" 2>&1 &
		echo "$!" > /var/run/udhcpd.pid
		sleep 1
		kill -0 "$(cat /var/run/udhcpd.pid)" 2>/dev/null ||
			log "udhcpd startete nicht - Clients bekommen keine Adresse"
	fi
	log "Rolle ap aktiv"
}

apply_role() {
	want=$1
	case "$want" in
		station) stop_ap;      start_station ;;
		ap)      stop_station; start_ap ;;
		off)     stop_ap;      stop_station; log "Rolle off" ;;
		*)       log "unbekannte Rolle '$want' - ignoriert"; return 1 ;;
	esac
}

# ---------------------------------------------------------------- main loop
umask 077
: > "$LOGFILE"
[ -f "$ROLE_FILE" ] || echo station > "$ROLE_FILE"

# BESITZ UEBERNEHMEN, bevor irgendeine Rolle hergestellt wird.
#
# Ohne das kommt die Station-Rolle nach einem unsauberen Ende nicht mehr hoch.
# apply_role station macht "stop_ap; start_station" -- stop_station wird also
# gerade dann NICHT gerufen, wenn noch ein Supplicant aus einem frueheren
# Leben laeuft. wpa_supplicant sagt dazu:
#
#     ctrl_iface exists and seems to be in use - cannot override it
#
# und das aendert sich von selbst nie; retry_start rennt zehnmal dagegen und
# gibt auf. Auf der Kamera gesehen, nicht ausgedacht.
#
# Dieser Prozess ist der einzige Besitzer von wlan0. Dann muss er den Besitz
# beim Start auch wirklich nehmen, statt anzunehmen, das Interface sei frei.
log "uebernehme $IFACE"
stop_ap
stop_station
claim_interface

current=""
while :; do
	want=$(cat "$ROLE_FILE" 2>/dev/null | tr -d ' \t\r\n')
	[ -n "$want" ] || want=station
	if [ "$want" != "$current" ]; then
		log "Wechsel $current -> $want"
		if apply_role "$want"; then
			current="$want"
		else
			# Nicht in einer Schleife wiederholen: ein fehlendes Binary oder
			# eine kaputte Konfiguration wird durch Nochmalversuchen nicht
			# besser, und alle zwei Sekunden einen Daemon anzuwerfen macht die
			# Box unbenutzbar. Der naechste Versuch kommt, wenn jemand die
			# Datei erneut aendert.
			current="$want"
			log "Rolle $want liess sich nicht herstellen - warte auf die naechste Aenderung"
		fi
	fi
	sleep $POLL
done
