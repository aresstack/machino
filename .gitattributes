# Shell scripts and CGI shipped to the camera must keep LF endings: a
# "#!/bin/sh\r" shebang does not start on Linux, and a Windows checkout would
# otherwise produce a bundle that fails on the camera with "bad interpreter".
*.sh            text eol=lf
machino/openipc/sbin/*      text eol=lf
machino/openipc/init/*      text eol=lf
machino/openipc/webui/*.cgi text eol=lf
